{
  "xsappname": "worksync",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Administrator access"
    },
    {
      "name": "$XSAPPNAME.Employee",
      "description": "Employee access"
    }
  ],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Administrator",
      "scope-references": [
        "$XSAPPNAME.Admin",
        "$XSAPPNAME.Employee"
      ]
    },
    {
      "name": "Employee",
      "description": "Employee",
      "scope-references": [
        "$XSAPPNAME.Employee"
      ]
    }
  ]
}