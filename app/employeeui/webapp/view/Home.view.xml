<mvc:View
    controllerName="com.amista.employeeui.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:uxap="sap.uxap"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:layout="sap.ui.layout.form"
    xmlns:fc="sap.f"
    xmlns:card="sap.f.cards"
>
    <Page id="employeeToolPage">
        
                <Title
                    text="WorkSync Employee"
                    level="H2"
                    class="sapUiTinyMarginBegin"/>



    <content>

        <IconTabBar
            id="profileIconTabBar"
            expandable="false"
            selectedKey="basic"
            class="sapUiResponsiveContentPadding">

            <items>

                <!-- Basic Information -->
                <IconTabFilter
                    key="basic"
                    text="Basic Information"
                    icon="sap-icon://employee">

                    <Panel
    headerText="Basic Information"
    class="sapUiMediumMarginBottom">

    <form:SimpleForm>

        <Label text="Name" />
        <Title
            text="{employee>NAME}"
            level="H4" />

        <Label text="Employee ID" />
        <Text text="{employee>EMP_ID}" />

        <Label text="Status" />
        <ObjectStatus
            text="{employee>STATUS}"/>

        <Label text="Email" />
        <Text text="{employee>EMAIL}" />

        <Label text="Phone Number" />
        <Text text="{employee>PHONE_NUMBER}" />

        <Label text="Experience" />
        <Text text="{employee>EXPERIENCE} Years" />

        <Label text="Joining Date" />
        <Text text="{employee>JOINING_DATE}" />

    </form:SimpleForm>

</Panel>

                </IconTabFilter>


                <!-- Work Information -->
                <IconTabFilter
                    key="work"
                    text="Work Information"
                    icon="sap-icon://work-history">

                    <Panel
                        headerText="Work Information"
                        class="sapUiMediumMarginBottom">

                        <VBox class="sapUiMediumMargin">

                            <Label
                                text="Allocation" />

                            <ProgressIndicator
                                width="20rem"
                                percentValue="{employee>ALLOCATION_PERCENT}"
                                displayValue="{employee>ALLOCATION_PERCENT}%"
                                state="{=
                                    ${employee>ALLOCATION_PERCENT} > 100
                                    ? 'Error'
                                    : ${employee>ALLOCATION_PERCENT} >= 80
                                    ? 'Warning'
                                    : 'Success'
                                }" />

                            <HBox class="sapUiMediumMarginTop">

                                <Label
                                    width="12rem"
                                    text="Status" />

                                <ObjectStatus
                                    text="{employee>STATUS}"
                                    state="{=
                                        ${employee>STATUS} === 'ACTIVE'
                                        ? 'Success'
                                        : 'Error'
                                    }" />

                            </HBox>

                        </VBox>

                    </Panel>
                     <Panel
        headerText="My Projects"
        class="sapUiMediumMarginTop"
        expandable="false">

        <List
            items="{projects>/value}"
            growing="true"
            noDataText="No Projects Assigned">

            <CustomListItem>

                <Panel
                    class="sapUiSmallMarginBottom sapUiResponsiveMargin">

                    <VBox class="sapUiMediumMargin">

                        <!-- Project Header -->
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <VBox>

                                <Title
                                    text="{projects>PROJECT_NAME}"
                                    level="H3" />

                                <Text
                                    text="{projects>PROJECT_ID}"
                                    class="sapUiTinyMarginTop" />

                            </VBox>

                            <ObjectStatus
                                text="{projects>PROJECT_STATUS}"
                                state="{=
                                    ${projects>PROJECT_STATUS} === 'ACTIVE'
                                    ? 'Success'
                                    : ${projects>PROJECT_STATUS} === 'COMPLETED'
                                    ? 'Information'
                                    : 'Warning'
                                }"
                                inverted="true" />

                        </HBox>


                        <!-- Description -->
                        <Text
                            text="{projects>DESCRIPTION}"
                            wrapping="true"
                            class="sapUiSmallMarginTop sapUiSmallMarginBottom" />


                        <!-- Project Information -->
                        <HBox
                            wrap="Wrap"
                            class="sapUiSmallMarginTop">

                            <VBox
                                width="12rem"
                                class="sapUiMediumMarginEnd sapUiSmallMarginBottom">

                                <Label text="Allocation" />

                                <ObjectNumber
                                    number="{projects>ALLOCATION_PERCENTAGE}"
                                    unit="%" />

                            </VBox>


                            <VBox
                                width="12rem"
                                class="sapUiMediumMarginEnd sapUiSmallMarginBottom">

                                <Label text="Priority" />

                                <ObjectStatus
                                    text="{projects>PROJECT_PRIORITY}"
                                    state="{=
                                        ${projects>PROJECT_PRIORITY} === 'HIGH'
                                        ? 'Error'
                                        : ${projects>PROJECT_PRIORITY} === 'MEDIUM'
                                        ? 'Warning'
                                        : 'Success'
                                    }" />

                            </VBox>


                            <VBox
                                width="12rem"
                                class="sapUiMediumMarginEnd sapUiSmallMarginBottom">

                                <Label text="Start Date" />

                                <Text
                                    text="{projects>PROJECT_START_DATE}" />

                            </VBox>


                            <VBox
                                width="12rem"
                                class="sapUiSmallMarginBottom">

                                <Label text="End Date" />

                                <Text
                                    text="{projects>PROJECT_END_DATE}" />

                            </VBox>

                        </HBox>

                    </VBox>

                </Panel>

            </CustomListItem>

        </List>

    </Panel>

                </IconTabFilter>


                <!-- Skills -->
                <IconTabFilter
                    key="skills"
                    text="Skills"
                    icon="sap-icon://competitor">

                    <Panel
                        headerText="Skills"
                        class="sapUiMediumMarginBottom"
                        expandable="false">

                        <Table
                            items="{skills>/value}"
                            noDataText="No Skills Found"
                            inset="false"
                            mode="None">

                            <columns>

                                <Column>
                                    <Text text="Skill" />
                                </Column>

                                <Column hAlign="End">
                                    <Text text="Proficiency" />
                                </Column>

                            </columns>

                            <items>

                                <ColumnListItem>

                                    <cells>

                                        <Text
                                            text="{skills>SKILL_NAME}"
                                            wrapping="false" />

                                        <ObjectStatus
                                            text="{skills>PROFICIENCY_LEVEL}"
                                            state="Success"
                                            inverted="true" />

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </Panel>

                </IconTabFilter>
                 <IconTabFilter
    key="leaves"
    text="My Leaves"
    icon="sap-icon://calendar">

    <VBox
        width="100%"
        class="sapUiMediumMargin">

        <!-- Leave Balance -->
        <Panel
            headerText="Leave Balance"
            expandable="false"
            class="sapUiMediumMarginBottom sapUiMediumMarginEnd">

            <HBox
                justifyContent="Start"
                wrap="Wrap"
                class="sapUiMediumMargin">

                <!-- Casual Leave -->
                <fc:Card
                    width="13rem"
                    height="10rem"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                    <fc:header>
                        <card:NumericHeader
                            title="Casual Leave"
                            subtitle="Available"
                            number="{leaveStats>/casual/available}"
                            state="Good">

                            <card:sideIndicators>
                                <card:NumericSideIndicator
                                    title="Used"
                                    number="{leaveStats>/casual/used}" />
                            </card:sideIndicators>

                        </card:NumericHeader>
                    </fc:header>

                </fc:Card>


                <!-- Sick Leave -->
                <fc:Card
                    width="13rem"
                    height="10rem"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                    <fc:header>
                        <card:NumericHeader
                            title="Sick Leave"
                            subtitle="Available"
                            number="{leaveStats>/sick/available}"
                            state="Good">

                            <card:sideIndicators>
                                <card:NumericSideIndicator
                                    title="Used"
                                    number="{leaveStats>/sick/used}" />
                            </card:sideIndicators>

                        </card:NumericHeader>
                    </fc:header>

                </fc:Card>


                <!-- Earned Leave -->
                <fc:Card
                    width="13rem"
                    height="10rem"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                    <fc:header>
                        <card:NumericHeader
                            title="Earned Leave"
                            subtitle="Available"
                            number="{leaveStats>/earned/available}"
                            state="Good">

                            <card:sideIndicators>
                                <card:NumericSideIndicator
                                    title="Used"
                                    number="{leaveStats>/earned/used}" />
                            </card:sideIndicators>

                        </card:NumericHeader>
                    </fc:header>

                </fc:Card>


                <!-- Pending -->
                <fc:Card
                    width="13rem"
                    height="10rem"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                    <fc:header>
                        <card:NumericHeader
                            title="Pending"
                            subtitle="Awaiting Approval"
                            number="{leaveStats>/pending}"
                            state="Critical" />
                    </fc:header>

                </fc:Card>

            </HBox>

        </Panel>


        <!-- Leave Calendar -->
        <Panel
            headerText="My Leave Calendar"
            expandable="false"
            class="sapUiMediumMarginBottom sapUiMediumMarginEnd">

            <VBox
                width="100%"
                alignItems="Center"
                class="sapUiMediumMarginBottom">

                <unified:Calendar
                    id="leaveCalendar"
                    months="3"
                    width="1050px"
                    class="sapUiMediumMarginTop" />

                <!-- Legend -->
                <HBox
                    justifyContent="Start"
                    alignItems="Center"
                    wrap="Wrap"
                    class="sapUiMediumMarginTop">

                    <HBox
                        alignItems="Center"
                        class="sapUiMediumMarginEnd">

                        <core:Icon
                            src="sap-icon://accept"
                            color="#107E3E"
                            class="sapUiTinyMarginEnd" />

                        <ObjectStatus
                            text="Approved"
                            state="Success" />

                    </HBox>


                    <HBox
                        alignItems="Center"
                        class="sapUiMediumMarginEnd">

                        <core:Icon
                            src="sap-icon://pending"
                            color="#2067ea"
                            class="sapUiTinyMarginEnd" />

                        <ObjectStatus
                            text="Pending"
                            state="Information" />

                    </HBox>


                    <HBox alignItems="Center">

                        <core:Icon
                            src="sap-icon://decline"
                            color="#BB0000"
                            class="sapUiTinyMarginEnd" />

                        <ObjectStatus
                            text="Rejected"
                            state="Error" />

                    </HBox>

                </HBox>

            </VBox>

        </Panel>


        <!-- Apply Leave -->
        <Panel
            headerText="Apply Leave"
            class="sapUiMediumMarginBottom sapUiContentPadding sapUiMediumMarginEnd">

            <layout:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                singleContainerFullSize="false">

                <Label text="Leave Type" />

                <Select
                    id="leaveType"
                    width="100%">

                    <items>

                        <core:Item
                            key="CASUAL"
                            text="Casual Leave" />

                        <core:Item
                            key="SICK"
                            text="Sick Leave" />

                        <core:Item
                            key="EARNED"
                            text="Earned Leave" />

                    </items>

                </Select>


                <Label text="From Date" />

                <DatePicker
                    id="leaveStartDate"
                    width="100%"
                    change="onLeaveDateChange" />


                <Label text="To Date" />

                <DatePicker
                    id="leaveEndDate"
                    width="100%"
                    change="onLeaveDateChange" />


                <Label text="Total Days" />

                <Input
                    id="leaveDays"
                    editable="false" />


                <Label text="Reason" />

                <TextArea
                    id="leaveReason"
                    rows="4"
                    width="100%"
                    placeholder="Enter reason for leave..." />


                <Label text="Confirm" />

                <Button
                    text="Apply Leave"
                    type="Emphasized"
                    icon="sap-icon://accept"
                    press=".onApplyLeave" />

            </layout:SimpleForm>

        </Panel>


        <!-- Leave History -->
        <Panel
            headerText="Leave History"
            class="sapUiMediumMarginBottom sapUiMediumMarginEnd">

            <Table
                growing="true"
                growingScrollToLoad="true"
                noDataText="No Leave Requests"
                items="{
                    path: 'leaves>/value',
                    sorter: {
                        path: 'LEAVE_FROM',
                        descending: true
                    }
                }">

                <columns>

                    <Column>
                        <Text text="Leave ID" />
                    </Column>

                    <Column>
                        <Text text="Type" />
                    </Column>

                    <Column>
                        <Text text="From Date" />
                    </Column>

                    <Column>
                        <Text text="To Date" />
                    </Column>

                    <Column>
                        <Text text="Days" />
                    </Column>

                    <Column>
                        <Text text="Reason" />
                    </Column>

                    <Column>
                        <Text text="Status" />
                    </Column>

                    <Column>
                        <Text text="Action" />
                    </Column>

                </columns>

                <items>

                    <ColumnListItem>

                        <cells>

                            <Text text="{leaves>LEAVE_ID}" />

                            <Text text="{leaves>LEAVE_TYPE}" />

                            <Text text="{leaves>LEAVE_FROM}" />

                            <Text text="{leaves>LEAVE_TO}" />

                            <Text text="{leaves>DAYS}" />

                            <Text
                                text="{leaves>REASON}"
                                maxLines="2" />

                            <ObjectStatus
                                text="{leaves>STATUS}"
                                state="{
                                    path: 'leaves>STATUS',
                                    formatter: '.leaveStatusFormatter'
                                }" />

                            <HBox>

                                <Button
                                    text="Cancel"
                                    type="Reject"
                                    visible="{= ${leaves>STATUS} === 'PENDING' }"
                                    press=".onCancelLeave" />

                                <Button
                                    text="Withdraw"
                                    type="Reject"
                                    visible="{= ${leaves>STATUS} === 'APPROVED' }"
                                    press=".onWithdrawLeave" />

                                <Text
                                    text="Withdrawal pending"
                                    visible="{= ${leaves>STATUS} === 'WITHDRAW_REQUEST' }" />

                            </HBox>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </Panel>

    </VBox>

</IconTabFilter>

            </items>

        </IconTabBar>

    </content>


    </Page>
</mvc:View>
