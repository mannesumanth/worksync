<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="editEmployeeDialog"
        title="Edit Employee"
        contentWidth="750px"
        contentHeight="650px"
        draggable="true"
        resizable="true">

        <content>

            <VBox>

                <!-- Employee Information -->

                <Panel
                    headerText="Employee Information"
                    expandable="false">

                    <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout">

                        <Label text="Employee ID"/>
                        <Input value="{EMP_ID}" editable="false"/>

                        <Label text="Name"/>
                        <Input value="{NAME}"/>

                        <Label text="Email"/>
                        <Input value="{EMAIL}" type="Email"/>

                        <Label text="Phone"/>
                        <Input value="{PHONE_NUMBER}"/>

                        <Label text="Date of Birth"/>
                        <DatePicker
                            value="{DATE_OF_BIRTH}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"/>

                        <Label text="Joining Date"/>
                        <DatePicker
                            value="{JOINING_DATE}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"/>

                        <Label text="Experience"/>
                        <Input
                            value="{EXPERIENCE}"
                            type="Number"/>

                        <Label text="Designation"/>

                        <Select
                            id="editDesignation"
                            items="{/DESIGNATIONS}"
                            selectedKey="{DESIGNATION_ID}">

                            <core:Item
                                key="{ID}"
                                text="{NAME}"/>

                        </Select>

                        <Label text="Role"/>

                        <Select selectedKey="{ROLE}">
                            <core:Item key="ADMIN" text="Admin"/>
                            <core:Item key="EMPLOYEE" text="Employee"/>
                        </Select>

                        <Label text="Status"/>

                        <Select selectedKey="{STATUS}">
                            <core:Item key="ONBOARDING" text="Onboarding"/>
                            <core:Item key="ACTIVE" text="Active"/>
                            <core:Item key="ON_LEAVE" text="On Leave"/>
                            <core:Item key="BENCH" text="Bench"/>
                            <core:Item key="RESIGNED" text="Resigned"/>
                            <core:Item key="TERMINATED" text="Terminated"/>
                        </Select>

                    </f:SimpleForm>

                </Panel>

                <!-- Employee Skills -->

                <Panel
                    headerText="Employee Skills"
                    class="sapUiMediumMarginTop">

                    <headerToolbar>

                        <Toolbar>

                            <Title text="Employee Skills"/>

                            <ToolbarSpacer/>

                            <Button
                                text="Add Skill"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onAddEmployeeSkill"/>

                        </Toolbar>

                    </headerToolbar>

                    <Table
                        id="editSkillsTable"
                        items="{skills}">

                        <columns>

                            <Column>
                                <Text text="Skill"/>
                            </Column>

                            <Column width="12rem">
                                <Text text="Level"/>
                            </Column>

                            <Column width="6rem">
                                <Text text=""/>
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem>

                                <cells>

                                    <Text
                                        text="{skill/SKILL_NAME}"/>

                                    <RatingIndicator
                                        value="{PROFICIENCY_LEVEL}"
                                        editable="true"
                                        visualMode="Full"
                                        maxValue="5"
                                        />

                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        press=".onDeleteEmployeeSkill"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </Panel>

            </VBox>

        </content>

        <beginButton>

            <Button
                text="Update Employee"
                type="Emphasized"
                press=".onUpdateEmployee"/>

        </beginButton>

        <endButton>

            <Button
                text="Cancel"
                press=".onCancelEmployee"/>

        </endButton>

    </Dialog>

</core:FragmentDefinition>