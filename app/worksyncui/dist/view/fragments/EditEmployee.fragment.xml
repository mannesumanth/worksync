<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="editEmployeeDialog"
        title="Edit Employee"
        contentWidth="750px"
        contentHeight="450px"
        draggable="true"
        resizable="true"
    >
        <content>
            <VBox>
                <Panel
                    headerText="Employee Information"
                    expandable="false"
                >
                    <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                    >
                        <Label text="Employee ID" />
                        <Input
                            value="{edit>/EMP_ID}"
                            editable="false"
                        />

                        <Label text="Name" />
                        <Input value="{edit>/NAME}" />

                        <Label text="Email" />
                        <Input
                            value="{edit>/EMAIL}"
                            type="Email"
                        />
                        <Label text="Gender" />

                        <Select
                            width="100%"
                            forceSelection="true"
                            selectedKey="{edit>/GENDER}"
                        >
                            <core:Item
                                key="MALE"
                                text="Male"
                            />

                            <core:Item
                                key="FEMALE"
                                text="Female"
                            />

                            <core:Item
                                key="OTHER"
                                text="Other"
                            />
                        </Select>

                        <Label text="Phone" />
                        <Input value="{edit>/PHONE_NUMBER}" />

                        <Label text="Date of Birth" />
                        <DatePicker
                            value="{edit>/DATE_OF_BIRTH}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                        />

                        <Label text="Joining Date" />
                        <DatePicker
                            value="{edit>/JOINING_DATE}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                        />

                        <Label text="Experience" />
                        <Input
                            value="{edit>/EXPERIENCE}"
                            type="Number"
                        />

                        <Label text="Designation" />

                        <Select
                            id="editDesignation"
                            width="100%"
                            forceSelection="false"
                            items="{/DESIGNATIONS}"
                            selectedKey="{edit>/designation_ID}"
                        >
                            <core:Item
                                key="{ID}"
                                text="{NAME}"
                            />
                        </Select>

                        <Label text="Role" />

                        <Select
                            width="100%"
                            forceSelection="false"
                            selectedKey="{edit>/ROLE}"
                        >
                            <core:Item
                                key="ADMIN"
                                text="Admin"
                            />

                            <core:Item
                                key="EMPLOYEE"
                                text="Employee"
                            />
                        </Select>

                        <Label text="Status" />

                        <Select
                            width="100%"
                            forceSelection="false"
                            selectedKey="{edit>/STATUS}"
                        >
                            <core:Item
                                key="ONBOARDING"
                                text="Onboarding"
                            />

                            <core:Item
                                key="ACTIVE"
                                text="Active"
                            />

                            <core:Item
                                key="ON_LEAVE"
                                text="On Leave"
                            />

                            <core:Item
                                key="BENCH"
                                text="Bench"
                            />

                            <core:Item
                                key="RESIGNED"
                                text="Resigned"
                            />

                            <core:Item
                                key="TERMINATED"
                                text="Terminated"
                            />
                        </Select>
                    </f:SimpleForm>
                </Panel>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Update Employee"
                type="Emphasized"
                press=".onUpdateEmployee"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelEmployee"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
