<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="designationDialog"
        title="Add Designation"
    >
        <VBox class="sapUiMediumMargin">
            <Label text="Designation Name" />
            <Input
                id="designationNameInput"
                placeholder="Software Engineer"
            />
            <Label text="Level" />
            <Input
                id="designationLevelInput"
                type="Number"
                placeholder="1"
            />
        </VBox>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveDesignation"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseDesignation"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
