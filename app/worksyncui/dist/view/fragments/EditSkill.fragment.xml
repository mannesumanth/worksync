<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="editSkillDialog"
        title="Edit Skill"
        contentWidth="30rem"
    >
        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
            >
                <Label text="Skill ID" />

                <Input
                    value="{edit>/SKILL_ID}"
                    editable="false"
                />

                <Label text="Skill Name" />

                <Input value="{edit>/SKILL_NAME}" />

                <Label text="Category" />

                <Select
                    selectedKey="{edit>/category_ID}"
                    items="{
        path:'/SKILL_CATEGORIES'
    }"
                >
                    <core:Item
                        key="{ID}"
                        text="{CATEGORY_NAME}"
                    />
                </Select>
            </f:SimpleForm>
        </content>

        <beginButton>
            <Button
                text="Update"
                type="Emphasized"
                press=".onUpdateSkill"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelSkill"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
