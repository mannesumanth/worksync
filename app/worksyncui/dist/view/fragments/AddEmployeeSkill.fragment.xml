<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="employeeSkillDialog"
        title="Assign Skill"
        contentWidth="400px">

        <VBox class="sapUiMediumMargin">

            <Label text="Skill" required="true"/>

            <ComboBox
                id="employeeSkillCombo"
                width="100%"
                items="{/SKILLS}">
                <core:Item
                    key="{ID}"
                    text="{SKILL_NAME}"/>
            </ComboBox>

            <Label
                text="Proficiency Level"
                required="true"/>

            <Select 
                id="addproficiencyLevel"
                selectedKey="BEGINNER"
                width="100%">

                <core:Item key="BEGINNER" text="Beginner"/>
                <core:Item key="INTERMEDIATE" text="Intermediate"/>
                <core:Item key="ADVANCED" text="Advanced"/>
                <core:Item key="EXPERT" text="Expert"/>

            </Select>

        </VBox>

        <beginButton>
            <Button
                text="Assign"
                type="Emphasized"
                press=".onSaveEmployeeSkill"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseEmployeeSkill"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>