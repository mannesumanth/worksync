<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="employeeSkillDialog"
        title="Assign Skill"
        contentWidth="400px">

        <VBox class="sapUiMediumMargin">

            <Label
                text="Skill"
                required="true"/>

            <ComboBox
                id="employeeSkillCombo"
                width="100%"
                items="{/SKILLS}">

                <core:Item
                    key="{ID}"
                    text="{SKILL_NAME}"/>

            </ComboBox>

            <Label
                text="Proficiency Level"
                required="true"
                class="sapUiSmallMarginTop"/>

            <Select
                id="proficiencyLevel"
                width="100%"
                selectedKey="3">

                <core:Item key="1" text="1 - Beginner"/>
                <core:Item key="2" text="2 - Basic"/>
                <core:Item key="3" text="3 - Intermediate"/>
                <core:Item key="4" text="4 - Advanced"/>
                <core:Item key="5" text="5 - Expert"/>

            </Select>

        </VBox>

        <beginButton>
            <Button
                text="Assign"
                type="Emphasized"
                press=".onSaveEmployeeSkill"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseEmployeeSkill"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>