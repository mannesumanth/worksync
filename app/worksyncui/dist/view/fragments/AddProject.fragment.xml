<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <Dialog
        id="addProjectDialog"
        title="Create Project"
        contentWidth="850px"
        contentHeight="650px"
        draggable="true"
        resizable="true"
    >
        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Project Name -->
                <Label
                    text="Project Name"
                    required="true"
                />
                <Input
                    id="projectName"
                    width="100%"
                    placeholder="Enter project name"
                />

                <!-- Description -->
                <Label
                    text="Description"
                    class="sapUiSmallMarginTop"
                />
                <TextArea
                    id="projectDescription"
                    rows="4"
                    width="100%"
                    placeholder="Enter project description"
                />

                <!-- Dates -->
                <HBox
                    class="sapUiMediumMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="48%">
                        <Label
                            text="Start Date"
                            required="true"
                        />
                        <DatePicker
                            id="projectStartDate"
                            width="100%"
                        />
                    </VBox>

                    <VBox width="48%">
                        <Label
                            text="End Date"
                            required="true"
                        />
                        <DatePicker
                            id="projectEndDate"
                            width="100%"
                        />
                    </VBox>
                </HBox>

                <!-- Status & Manager -->
                <HBox
                    class="sapUiMediumMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="48%">
                        <Label
                            text="Project Status"
                            required="true"
                        />
                        <Select
                            id="projectStatus"
                            width="100%"
                        >
                            <items>
                                <core:Item
                                    key="ACTIVE"
                                    text="ACTIVE"
                                />
                                <core:Item
                                    key="COMPLETED"
                                    text="COMPLETED"
                                />
                                <core:Item
                                    key="ON_HOLD"
                                    text="ON HOLD"
                                />
                            </items>
                        </Select>
                    </VBox>

                    <VBox width="48%">
                        <Label
                            text="Project Manager"
                            required="true"
                        />
                        <Select
                            id="projectManager"
                            width="100%"
                            items="{ path:'/EMPLOYEES' }"
                        >
                            <core:Item
                                key="{ID}"
                                text="{NAME}"
                            />
                        </Select>
                    </VBox>
                </HBox>

                <!-- Skills Section -->
                <Toolbar class="sapUiLargeMarginTop">
                    <Title text="Required Skills" />
                    <ToolbarSpacer />
                    <Button
                        text="Add Skill"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddRequiredSkill"
                    />
                </Toolbar>

                <Table
                    id="requiredSkillsTable"
                    inset="false"
                    class="sapUiSmallMarginTop"
                    items="{projectModel>/skills}"
                >
                    <columns>

                        <Column width="55%">
                            <Text text="Skill" />
                        </Column>

                        <Column width="30%">
                            <Text text="Required Level" />
                        </Column>

                        <Column width="15%">
                            <Text text="" />
                        </Column>

                    </columns>

                    <items>
                        <ColumnListItem>

                            <cells>

                                <Select
                                    width="100%"
                                    selectedKey="{projectModel>skill_ID}"
                                    items="{ path:'/SKILLS' }"
                                >
                                    <core:Item
                                        key="{ID}"
                                        text="{SKILL_NAME}"
                                    />
                                </Select>

                                <Input
                                    width="100%"
                                    type="Number"
                                    value="{projectModel>REQUIRED_LEVEL}"
                                    placeholder="1 - 5"
                                />

                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Remove Skill"
                                    press=".onDeleteRequiredSkill"
                                />

                            </cells>

                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Create Project"
                type="Emphasized"
                press=".onSaveProject"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseProjectDialog"
            />
        </endButton>

    </Dialog>
</core:FragmentDefinition>