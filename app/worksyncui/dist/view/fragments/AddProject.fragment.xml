<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:table="sap.ui.table"
>
    <Dialog
        id="addProjectDialog"
        title="Create Project"
        contentWidth="800px"
        contentHeight="600px"
        draggable="true"
        resizable="true"
    >
        <content>
            <VBox class="sapUiMediumMargin">
                <Label
                    text="Project Name"
                    required="true"
                />
                <Input
                    id="projectName"
                    placeholder="Enter Project Name"
                />
                <Label
                    text="Description"
                    class="sapUiSmallMarginTop"
                />
                <TextArea
                    id="projectDescription"
                    rows="3"
                    placeholder="Enter Project Description"
                />
                <HBox
                    class="sapUiSmallMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="48%">
                        <Label
                            text="Start Date"
                            required="true"
                        />
                        <DatePicker
                            id="projectStartDate"
                            width="100%"
                        />
                    </VBox>
                    <VBox width="48%">
                        <Label
                            text="End Date"
                            required="true"
                        />
                        <DatePicker
                            id="projectEndDate"
                            width="100%"
                        />
                    </VBox>
                </HBox>
                <HBox
                    class="sapUiSmallMarginTop"
                    justifyContent="SpaceBetween"
                >
                    <VBox width="48%">
                        <Label
                            text="Status"
                            required="true"
                        />
                        <Select id="projectStatus">
                            <items>
                                <core:Item
                                    key="ACTIVE"
                                    text="ACTIVE"
                                />
                                <core:Item
                                    key="COMPLETED"
                                    text="COMPLETED"
                                />
                                <core:Item
                                    key="ON_HOLD"
                                    text="ON HOLD"
                                />
                            </items>
                        </Select>
                    </VBox>
                    <VBox width="48%">
                        <Label
                            text="Manager"
                            required="true"
                        />
                        <Select
                            id="projectManager"
                            items="{
                                path: '/EMPLOYEES'
                            }"
                        >
                            <core:Item
                                key="{ID}"
                                text="{NAME}"
                            />
                        </Select>
                    </VBox>
                </HBox>
                <Toolbar class="sapUiMediumMarginTop">
                    <Title text="Required Skills" />
                    <ToolbarSpacer />
                    <Button
                        text="Add Skill"
                        icon="sap-icon://add"
                        press=".onAddRequiredSkill"
                    />
                </Toolbar>
                <Table
                    id="requiredSkillsTable"
                    inset="false"
                    items="{projectModel>/skills}"
                >
                    <columns>
                        <Column>
                            <Text text="Skill" />
                        </Column>
                        <Column>
                            <Text text="Proficiency Level" />
                        </Column>
                        <Column width="5rem">
                            <Text text="" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Select
                                    selectedKey="{projectModel>skill_ID}"
                                    items="{
                                        path: '/SKILLS'
                                    }"
                                >
                                    <core:Item
                                        key="{ID}"
                                        text="{SKILL_NAME}"
                                    />
                                </Select>
                                <Input
                                    type="Number"
                                    value="{projectModel>REQUIRED_LEVEL}"
                                    placeholder="1 - 5"
                                />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    press=".onDeleteRequiredSkill"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Create"
                type="Emphasized"
                press=".onSaveProject"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseProjectDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
