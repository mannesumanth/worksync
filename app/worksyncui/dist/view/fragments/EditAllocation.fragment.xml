<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="editAllocationDialog"
        title="Edit Allocation"
        contentWidth="500px">

        <content>

            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout">

                <Label text="Employee"/>

                <Input
                    value="{employee/NAME}"
                    editable="false"/>

                <Label text="Project Role"/>

                <Input
                    value="{PROJECT_ROLE}"/>

                <Label text="Allocation Percentage"/>

                <StepInput
                    value="{ALLOCATION_PERCENTAGE}"
                    min="1"
                    max="100"
                    step="5"/>

                <Label text="Start Date"/>

                <DatePicker
                    value="{
                        path:'START_DATE',
                        type:'sap.ui.model.odata.type.Date'
                    }"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd MMM yyyy"/>

                <Label text="End Date"/>

                <DatePicker
                    value="{
                        path:'END_DATE',
                        type:'sap.ui.model.odata.type.Date'
                    }"
                    valueFormat="yyyy-MM-dd"
                    displayFormat="dd MMM yyyy"/>

            </f:SimpleForm>

        </content>

        <beginButton>

            <Button
                text="Update"
                type="Emphasized"
                press=".onUpdateAllocation"/>

        </beginButton>

        <endButton>

            <Button
                text="Cancel"
                press=".onCancelEditAllocation"/>

        </endButton>

    </Dialog>

</core:FragmentDefinition>