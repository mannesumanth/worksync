<mvc:View
    controllerName="com.amista.worksyncui.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="homePage"
        showHeader="false"
        enableScrolling="false">

        <content>
            <VBox
                width="100%"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
                class="sapUiLargeMargin">

                <Title
                    text="Welcome to WorkSync"
                    level="H1"
                    class="sapUiSmallMarginBottom"/>

                <Text
                    text="Select the workspace you want to access."
                    textAlign="Center"
                    class="sapUiMediumMarginBottom"/>

                <Button
                    id="adminButton"
                    text="Admin Workspace"
                    icon="sap-icon://manager"
                    type="Emphasized"
                    width="18rem"
                    press=".onAdminPress"
                    class="sapUiSmallMarginBottom"/>

                <Button
                    id="employeeButton"
                    text="Employee Workspace"
                    icon="sap-icon://employee"
                    width="18rem"
                    press=".onEmployeePress"/>

            </VBox>
        </content>

    </Page>

</mvc:View>