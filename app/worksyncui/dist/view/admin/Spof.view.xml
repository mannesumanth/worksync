<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="com.amista.worksyncui.controller.admin.Spof"
    xmlns:core="sap.ui.core">
<Page id="spofPage" title="SPOF Risks">
                    <content>
                        <VBox class="sapUiMediumMargin">
                            <Table id="spofTable" inset="false" sticky="ColumnHeaders" growing="true" growingThreshold="20" growingScrollToLoad="true" noDataText="No SPOF risks identified" items="{spof>/risks}">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Single Point of Failure Risks" level="H3" />

                                        <ToolbarSpacer />

                                        <ObjectStatus text="{= ${spof>/risks}.length + ' Risks Found'}" state="Warning" />
                                    </OverflowToolbar>
                                </headerToolbar>

                                <columns>
                                    <Column width="18rem">
                                        <Text text="Skill" />
                                    </Column>

                                    <Column width="18rem">
                                        <Text text="Employee" />
                                    </Column>

                                    <Column width="9rem">
                                        <Text text="Employee ID" />
                                    </Column>

                                    <Column width="10rem" hAlign="Center">
                                        <Text text="Risk Level" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{spof>SKILL_NAME}" />

                                            <ObjectIdentifier title="{spof>EMPLOYEE_NAME}" />

                                            <Text text="{spof>EMP_ID}" />

                                            <ObjectStatus text="{spof>RISK_LEVEL}" state="{
                                    path: 'spof>RISK_LEVEL',
                                    formatter: '.riskStateFormatter'
                                }" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </content>
                </Page>
                </mvc:View>