{
	"_version": "1.85.0",
	"sap.app": {
		"id": "com.amista.worksyncui",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:basic",
			"version": "1.27.0",
			"toolsId": "e8b047e0-b479-46b0-a9e8-09b6d16a6fbd"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/admin/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			},
			"employeeService": {
				"uri": "/odata/v4/employee/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"worksync-display": {
					"semanticObject": "worksync",
					"action": "display",
					"title": "{{worksync-display.flpTitle}}",
					"subTitle": "{{worksync-display.flpSubtitle}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.149.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {},
				"sap.f": {},
				"sap.ui.unified": {},
				"sap.tnt": {},
				"sap.viz": {},
				"sap.suite.ui.microchart": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.amista.worksyncui.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"controlAggregation": "pages",
				"controlId": "fcl",
				"transition": "slide",
				"type": "View",
				"viewType": "XML",
				"path": "com.amista.worksyncui.view",
				"async": true,
				"viewPath": "com.amista.worksyncui.view"
			},
			"routes": [
				{
					"name": "Home",
					"pattern": "",
					"target": "Home"
				},
				{
					"name": "Admin",
					"pattern": "admin",
					"target": "Admin"
				},
				{
					"name": "Employee",
					"pattern": "employee",
					"target": "Employee"
				},
				{
					"name": "Forecast",
					"pattern": "forecast",
					"target": [
						"Admin",
						"Forecast"
					]
				},
				{
					"name": "AdminEmployeeDetail",
					"pattern": "employee/{employeeId}",
					"target": [
						"Admin",
						"AdminEmployeeDetail"
					]
				},
				{
					"name": "ProjectDetail",
					"pattern": "project/{projectId}",
					"target": [
						"Admin",
						"ProjectDetail"
					]
				}
			],
			"targets": {
				"Home": {
					"id": "Home",
					"name": "Home",
					"viewName": "Home",
					"controlAggregation": "beginColumnPages"
				},
				"Admin": {
					"id": "Admin",
					"name": "Admin",
					"viewName": "Admin",
					"controlAggregation": "beginColumnPages"
				},
				"Employee": {
					"id": "Employee",
					"name": "Employee",
					"viewName": "Employee",
					"controlAggregation": "beginColumnPages"
				},
				"AdminEmployeeDetail": {
					"id": "AdminEmployeeDetail",
					"name": "AdminEmployeeDetail",
					"viewName": "AdminEmployeeDetail",
					"controlAggregation": "midColumnPages"
				},
				"ProjectDetail": {
					"id": "ProjectDetail",
					"name": "ProjectDetail",
					"viewName": "ProjectDetail",
					"controlAggregation": "midColumnPages"
				},
				"Forecast": {
					"id": "Forecast",
					"name": "Forecast",
					"viewName": "Forecast",
					"controlAggregation": "midColumnPages"
				}
			}
		},
		"rootView": {
			"viewName": "com.amista.worksyncui.view.App",
			"type": "XML",
			"id": "App",
			"async": true
		},
		"flexBundle": false
	},
	"sap.cloud": {
		"public": true,
		"service": "worksync-approuter"
	}
}