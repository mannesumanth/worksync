<mvc:View
    controllerName="com.amista.worksyncui.controller.EmployeeDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page
        title="Employee Details"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <content>
            <ObjectHeader
                title="{NAME}"
                number="{EMP_ID}"
                numberUnit="Employee ID">
                <statuses>
                    <ObjectStatus
                        text="{STATUS}"
                        state="Success"
                    />
                </statuses>
            </ObjectHeader>
            <f:SimpleForm
                editable="false"
                layout="ResponsiveGridLayout"
            >
                <Label text="Employee ID" />
                <Text text="{EMP_ID}" />
                <Label text="Name" />
                <Text text="{NAME}" />
                <Label text="Email" />
                <Text text="{EMAIL}" />
                <Label text="Phone" />
                <Text text="{PHONE_NUMBER}" />
                <Label text="Date of Birth" />
                <Text text="{DATE_OF_BIRTH}" />
                <Label text="Joining Date" />
                <Text text="{JOINING_DATE}" />
                <Label text="Experience" />
                <Text text="{EXPERIENCE}" />
                <Label text="Role" />
                <Text text="{ROLE}" />
                <Label text="Status" />
                <Text text="{STATUS}" />
            </f:SimpleForm>
            <Table items="{skills}">
                <columns>
                    <Column>
                        <Text text="Skill" />
                    </Column>
                    <Column>
                        <Text text="Proficiency" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{skill/SKILL_NAME}" />
                            <ObjectNumber number="{PROFICIENCY_LEVEL}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            
            <Toolbar>
                <ToolbarSpacer />
                <Button
                    text="Add Skill"
                    icon="sap-icon://add"
                    press="onAddEmployeeSkill"
                />
                <Button
                    text="Edit"
                    icon="sap-icon://edit"
                    press="onEditEmployee"
                />
                <Button
                    text="Deactivate"
                    icon="sap-icon://decline"
                    type="Reject"
                    press="onDeactivateEmployee"
                />
            </Toolbar>
        </content>
    </Page>
</mvc:View>
