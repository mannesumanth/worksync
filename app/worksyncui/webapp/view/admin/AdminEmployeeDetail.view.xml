<mvc:View
    controllerName="com.amista.worksyncui.controller.admin.AdminEmployeeDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
>
    <Page
        title="Employee Details"
        showNavButton="true"
        navButtonPress="onNavBack">
    <headerContent>
                <Button
                    text="Edit Employee"
                    icon="sap-icon://edit"
                    type="Emphasized"
                    press="onEditEmployee"
                />
            </headerContent>
        <content>
            <!-- Employee Header -->
            <ObjectHeader
                title="{NAME}"
                number="{EMP_ID}"
                intro="{designation/NAME}"
                responsive="true"
            >
                <statuses>
                    <ObjectStatus
                        text="{STATUS}"
                        state="{= ${STATUS} === 'ACTIVE' ? 'Success' :
                     ${STATUS} === 'ON_LEAVE' ? 'Warning' :
                     ${STATUS} === 'BENCH' ? 'Information' : 'Error'}"
                    />
                </statuses>

                <attributes>
                    <ObjectAttribute
                        title="Email"
                        text="{EMAIL}"
                    />

                    <ObjectAttribute
                        title="Phone"
                        text="{PHONE_NUMBER}"
                    />

                    <ObjectAttribute
                        title="Experience"
                        text="{EXPERIENCE} Years"
                    />
                </attributes>
            </ObjectHeader>

            <!-- Employee Information -->
            <Panel
                headerText="Employee Information"
                expandable="false"
                class="sapUiMediumMarginTop"
            >
                <f:SimpleForm
                    editable="false"
                    layout="ResponsiveGridLayout"
                >
                    <Label text="Employee ID" />
                    <Text text="{EMP_ID}" />

                    <Label text="Name" />
                    <Text text="{NAME}" />

                    <Label text="Email" />
                    <Text text="{EMAIL}" />

                    <Label text="Gender" />
                    <Text text="{GENDER}" />

                    <Label text="Phone" />
                    <Text text="{PHONE_NUMBER}" />

                    <Label text="Date of Birth" />
                    <Text text="{DATE_OF_BIRTH}" />

                    <Label text="Joining Date" />
                    <Text text="{JOINING_DATE}" />

                    <Label text="Designation" />
                    <Text text="{designation/NAME}" />

                    <Label text="Experience" />
                    <Text text="{EXPERIENCE} Years" />

                    <Label text="Status" />
                    <ObjectStatus
                        text="{STATUS}"
                        state="Success"
                    />
                </f:SimpleForm>
            </Panel>

            <!-- Skills -->
            <Panel
                headerText="Employee Skills"
                expandable="false"
                class="sapUiMediumMarginTop"
            >
                <headerToolbar>
                    <Toolbar>
                        <Title text="Employee Skills" />

                        <ToolbarSpacer />

                        <Button
                            text="Add Skill"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onAddEmployeeSkill"
                        />
                    </Toolbar>
                </headerToolbar>

                <Table
                    growing="true"
                    growingThreshold="5"
                    items="{skills}"
                >
                    <columns>
                        <Column>
                            <Text text="Skill" />
                        </Column>

                        <Column >
                            <Text text="Proficiency" />
                        </Column>
                        <Column >
                            <Text text="Edit" />
                        </Column>
                        <Column >
                            <Text text="Delete" />
                        </Column>

                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{skill/SKILL_NAME}" />
                                <Text text="{PROFICIENCY_LEVEL}" />
                                <Button
                    icon="sap-icon://edit"
                    type="Transparent"
                    tooltip="Edit Skill"
                    press=".onEditEmployeeSkill"/>

                <Button
                    icon="sap-icon://delete"
                    type="Transparent"
                    tooltip="Delete Skill"
                    press=".onDeleteEmployeeSkill"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <!-- Project Allocations -->
            <Panel
                headerText="Project Allocations"
                expandable="false"
                class="sapUiMediumMarginTop"
            >
                <Table
                    id="tblAllocations"
                    width="100%"
                    growing="true"
                    growingThreshold="5"
                    items="{allocations}"
                >
                    <columns>
                        <Column width="8rem">
                            <Text text="Project ID" />
                        </Column>

                        <Column width="15rem">
                            <Text text="Project Name" />
                        </Column>

                        <Column width="12rem">
                            <Text text="Project Role" />
                        </Column>

                        <Column width="10rem">
                            <Text text="Allocation" />
                        </Column>

                        <Column width="10rem">
                            <Text text="Start Date" />
                        </Column>

                        <Column width="10rem">
                            <Text text="End Date" />
                        </Column>

                        <!-- <Column width="10rem">
                            <Text text="Status" />
                        </Column> -->
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{project/PROJECT_ID}" />

                                <Text text="{project/PROJECT_NAME}" />

                                <Text text="{PROJECT_ROLE}" />

                                <ProgressIndicator
                                    percentValue="{ALLOCATION_PERCENTAGE}"
                                    displayValue="{ALLOCATION_PERCENTAGE}%"
                                />
                                <Text text="{START_DATE}" />
                                <Text text="{END_DATE}" />

                                <!-- Text
                                    text="{
                                        path:'START_DATE',
                                        type:'sap.ui.model.type.Date',
                                        formatOptions:{style:'medium'}
                                    }"
                                />

                                <Text
                                    text="{
                                        path:'END_DATE',
                                        type:'sap.ui.model.type.Date',
                                        formatOptions:{style:'medium'}
                                    }"
                                --> 

                                <!-- <ObjectStatus
                                    text="{STATUS}"
                                    state="{= ${STATUS} === 'ACTIVE' ? 'Success'
                                        : ${STATUS} === 'PLANNED' ? 'Information'
                                        : ${STATUS} === 'COMPLETED' ? 'Success'
                                        : 'Warning'}"
                                /> -->
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
