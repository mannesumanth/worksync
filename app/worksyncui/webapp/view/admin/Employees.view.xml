<mvc:View controllerName="com.amista.worksyncui.controller.admin.Employees"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Page id="employeesPage" title="Employees" class="sapUiResponsiveContentPadding">
		<headerContent>
			<Button text="Add Employee" icon="sap-icon://add" type="Emphasized" press="onAddEmployee" />
		</headerContent>
		<content>
				<OverflowToolbar id="employeeFilterBar" design="Transparent" class="sapUiSmallMarginBottom">

					<SearchField id="employeeSearch" width="100%" placeholder="Search by Employee ID, Name or Email" liveChange="onEmployeeFilterChange">
						<layoutData>
							<OverflowToolbarLayoutData shrinkable="true" minWidth="12rem" priority="NeverOverflow" />
						</layoutData>
					</SearchField>

					<ToolbarSpacer>
						<layoutData>
							<OverflowToolbarLayoutData priority="Low" />
						</layoutData>
					</ToolbarSpacer>

					<Select id="designationFilter" width="10rem" autoAdjustWidth="true" selectedKey="" change="onEmployeeFilterChange" items="{designationModel>/designations}">
						<core:Item key="{designationModel>ID}" text="{designationModel>NAME}" />
						<layoutData>
							<OverflowToolbarLayoutData priority="Low" group="1" />
						</layoutData>
					</Select>

					<Select id="statusFilter1" width="9rem" autoAdjustWidth="true" change="onEmployeeFilterChange">
						<core:Item key="" text="All Status" />
						<core:Item key="ACTIVE" text="Active" />
						<core:Item key="ONBOARDING" text="Onboarding" />
						<core:Item key="ON_LEAVE" text="On Leave" />
						<core:Item key="BENCH" text="Bench" />
						<core:Item key="RESIGNED" text="Resigned" />
						<core:Item key="TERMINATED" text="Terminated" />
						<layoutData>
							<OverflowToolbarLayoutData priority="Low" group="1" />
						</layoutData>
					</Select>
					<Input id="experienceFilter" width="8rem" placeholder="Min Exp" liveChange="onEmployeeFilterChange">
						<layoutData>
							<OverflowToolbarLayoutData priority="Low" group="2" />
						</layoutData>
					</Input>
					<Input id="maxExperienceFilter" width="8rem" placeholder="Max Exp" liveChange="onEmployeeFilterChange">
						<layoutData>
							<OverflowToolbarLayoutData priority="Low" group="2" />
						</layoutData>
					</Input>
                    <Button text="Clear" icon="sap-icon://clear-filter" type="Transparent" press="onClearFilters"/>
				</OverflowToolbar>
				<Table id="employeesTable"
					sticky="ColumnHeaders,HeaderToolbar"
					width="100%"
					showSeparators="Inner"
					backgroundDesign="Transparent"
					noDataText="No employees found"
					items="{
                        path: 'table>/EMPLOYEES',
                        sorter: {
                            path: 'EMP_ID'
                        }
                    }">
					<headerToolbar>
						<Toolbar>
							<Title text="{= ${table>/EMPLOYEES}.length + ' Employees'}" level="H2" />
						</Toolbar>
					</headerToolbar>
					<columns>
						<Column width="6rem" importance="High">
							<Text text="EMP ID" />
						</Column>
						<Column importance="High" minScreenWidth="Tablet" demandPopin="false">
							<Text text="Employee Name" />
						</Column>
						<Column importance="Medium" minScreenWidth="Tablet" demandPopin="true">
							<Text text="Email" />
						</Column>
						<Column importance="Medium" minScreenWidth="Phone" demandPopin="true">
							<Text text="Designation" />
						</Column>
						<Column hAlign="Center" importance="Low" minScreenWidth="Tablet" demandPopin="true">
							<Text text="Experience" />
						</Column>
						<Column importance="High" hAlign="Center">
							<Text text="Status" />
						</Column>
						<Column importance="Medium" minScreenWidth="Tablet" demandPopin="true" width="12rem">
							<Text text="Allocation" />
						</Column>
						<Column hAlign="Center" importance="High" width="4rem">
							<Text text="View" />
						</Column>
					</columns>
					<items>
						<ColumnListItem type="Active" press=".onViewEmployee">
							<cells>
								<Text text="{table>EMP_ID}" />
								<Text text="{table>NAME}" />
								<Text text="{table>EMAIL}" />
								<Text text="{table>designation/NAME}" />
								<Text text="{table>EXPERIENCE} yrs" />
								<ObjectStatus text="{table>STATUS}" state="{=
                                        ${table>STATUS} === 'ACTIVE' ? 'Success' :
                                        ${table>STATUS} === 'ON_LEAVE' ? 'Warning' :
                                        ${table>STATUS} === 'BENCH' ? 'Information' :
                                        'Error'
                                    }" />
								<ProgressIndicator percentValue="{table>ALLOCATION_PERCENT}" displayValue="{table>ALLOCATION_PERCENT}%" state="{=
                                        ${table>ALLOCATION_PERCENT} >= 100 ? 'Error' :
                                        ${table>ALLOCATION_PERCENT} >= 80 ? 'Warning' :
                                        'Success'
                                    }" />
								<Button icon="sap-icon://display" tooltip="View Employee" type="Transparent" press="onViewEmployee" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
		</content>
	</Page>
</mvc:View>