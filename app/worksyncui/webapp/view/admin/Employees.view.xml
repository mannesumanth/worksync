<mvc:View controllerName="com.amista.worksyncui.controller.admin.Employees"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Page 
		id="employeesPage" 
		title="Employees" 
		class="sapUiResponsiveContentPadding">
		<headerContent>
		<!-- Add Employee Button -->
			<Button 
				text="Add Employee" 
				icon="sap-icon://add" 
				type="Emphasized" 
				press="onAddEmployee" />
		</headerContent>
			<content>
				<OverflowToolbar 
					id="employeeFilterBar" 
					design="Transparent" 
					class="sapUiSmallMarginBottom">
					<!-- search Field -->
					<SearchField 
						id="employeeSearch" 
						width="100%" 
						placeholder="Search by Employee ID, Name or Email" 
						liveChange="onEmployeeFilterChange">

						<layoutData>
							<OverflowToolbarLayoutData 
								shrinkable="true" 
								minWidth="12rem" 
								priority="NeverOverflow" />
						</layoutData>
					</SearchField>

					<ToolbarSpacer>
						<layoutData>
							<OverflowToolbarLayoutData priority="Low" />
						</layoutData>
					</ToolbarSpacer>
					<!-- Designation Filter -->
					<Select 
						id="designationFilter" 
						width="10rem" 
						autoAdjustWidth="true" 
						selectedKey="" change="onEmployeeFilterChange" 
						items="{path:'designationModel>/designations'}">

						<core:Item 
							key="{designationModel>ID}" 
							text="{designationModel>NAME}" />
						<layoutData>
							<OverflowToolbarLayoutData 
								priority="Low" 
								group="1" />
						</layoutData>
					</Select>
					<!-- Status Filter -->
					<Select 
						id="statusFilter1" 
						width="9rem" 
						autoAdjustWidth="true" 
						change="onEmployeeFilterChange">

						<core:Item key="" text="All Status" />
						<core:Item key="ACTIVE" text="Active" />
						<core:Item key="BENCH" text="Bench" />
						<core:Item key="ONBOARDING" text="Onboarding" />
						<core:Item key="ON_LEAVE" text="On Leave" />
						
						<core:Item key="RESIGNED" text="Resigned" />
						<core:Item key="TERMINATED" text="Terminated" />
						<layoutData>
							<OverflowToolbarLayoutData 
								priority="Low" 
								group="1" />
						</layoutData>
					</Select>
					<!-- Min Exp -->
					<Input 
						id="experienceFilter" 
						width="8rem" 
						placeholder="Min Exp" 
						liveChange="onEmployeeFilterChange">

						<layoutData>
							<OverflowToolbarLayoutData 
								priority="Low" 
								group="2" />
						</layoutData>
					</Input>
					<!-- Max Exp -->
					<Input 
						id="maxExperienceFilter" 
						width="8rem" 
						placeholder="Max Exp" 
						liveChange="onEmployeeFilterChange">
						<layoutData>
							<OverflowToolbarLayoutData 
								priority="Low" 
								group="2" />
						</layoutData>
					</Input>
                    <Button 
						text="Clear" 
						icon="sap-icon://clear-filter" 
						type="Transparent" 
						press="onClearFilters"/>

				</OverflowToolbar>
				<!-- Employees Table -->
				<Table 
					id="employeesTable"
					sticky="ColumnHeaders,HeaderToolbar"
					width="100%"
					noDataText="No employees found"
					items="{
                        path: 'table>/EMPLOYEES',
                        sorter: {
                            path: 'EMP_ID'
                        }
                    }">
					<headerToolbar>
						<Toolbar>
							<Title text="{= ${table>/EMPLOYEES}.length + ' Employees'}" level="H2" />
						</Toolbar>
					</headerToolbar>
					<columns>
						<Column >
							<Text text="EMP ID" />
						</Column>
						<Column >
							<Text text="Employee Name" />
						</Column>
						<Column >
							<Text text="Email" />
						</Column>
						<Column >
							<Text text="Designation" />
						</Column>
						<Column >
							<Text text="Experience" />
						</Column>
						<Column >
							<Text text="Status" />
						</Column>
						<Column>
							<Text text="Allocation" />
						</Column>
						<Column >
							<Text text="View" />
						</Column>
					</columns>
					<items>
						<!-- On View Employee -->
						<ColumnListItem type="Active" >
							<cells>
								<Text text="{table>EMP_ID}" />
								<Text text="{table>NAME}" />
								<Text text="{table>EMAIL}" />
								<Text text="{table>designation/NAME}" />
								<Text text="{table>EXPERIENCE} yrs" />
								<ObjectStatus text="{table>STATUS}" state="{=
                                        ${table>STATUS} === 'ACTIVE' ? 'Success' :
                                        ${table>STATUS} === 'ON_LEAVE' ? 'Warning' :
                                        ${table>STATUS} === 'BENCH' ? 'Information' :
                                        'Error'
                                    }" />
								<ProgressIndicator 
									percentValue="{table>ALLOCATION_PERCENT}" 
									displayValue="{table>ALLOCATION_PERCENT}%" state="{=
                                        ${table>ALLOCATION_PERCENT} >= 100 ? 'Error' :
                                        ${table>ALLOCATION_PERCENT} >= 80 ? 'Warning' :
                                        'Success'
                                    }" />
								<Button 
									icon="sap-icon://display" 
									tooltip="View Employee" 
									type="Transparent" 
									press=".onViewEmployee" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</content>
		</Page>
</mvc:View>