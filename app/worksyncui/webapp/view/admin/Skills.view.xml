<mvc:View
    controllerName="com.amista.worksyncui.controller.admin.Skills"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
<Page id="adminskillsPage" title="Skills">
                    <headerContent>
                        <Button text="Add Skill" icon="sap-icon://add" type="Emphasized" press="onOpenSkillDialog" />

                        <Button text="Delete" icon="sap-icon://delete" type="Negative" press="onDeleteSkill" />
                    </headerContent>

                    <content>
                        <VBox class="sapUiMediumMargin">
                            <Table id="skillsTable" mode="SingleSelectLeft" inset="false" sticky="ColumnHeaders" noDataText="No skills available" items="{
                    path: '/SKILLS',
                    parameters: {
                        $expand: 'category'
                    }
                }">
                                <columns>
                                    <Column width="9rem">
                                        <Text text="Skill ID" />
                                    </Column>

                                    <Column width="18rem">
                                        <Text text="Skill Name" />
                                    </Column>

                                    <Column width="18rem">
                                        <Text text="Category" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{SKILL_ID}" />

                                            <Text text="{SKILL_NAME}" />

                                            <Text text="{category/CATEGORY_NAME}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                        <VBox class="sapUiMediumMargin">
                            <Table id="skillCategoriesTable" mode="SingleSelectLeft" inset="false" sticky="ColumnHeaders" noDataText="No skill categories available" items="{/SKILL_CATEGORIES}">
                                <columns>
                                    <Column width="10rem">
                                        <Text text="Category ID" />
                                    </Column>

                                    <Column width="20rem">
                                        <Text text="Category Name" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{CAT_ID}" />
                                            <Text text="{CATEGORY_NAME}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </content>
                </Page>
</mvc:View>