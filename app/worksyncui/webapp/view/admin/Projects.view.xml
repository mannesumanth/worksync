<mvc:View
    controllerName="com.amista.worksyncui.controller.admin.Projects"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fc="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:suite="sap.suite.ui.microchart">

    <Page id="adminprojectsPage" title="Projects">

        <headerContent>
            <Button
                text="Create Project"
                icon="sap-icon://add"
                type="Emphasized"
                press="onCreateProject" />
        </headerContent>

        <content>
            <VBox class="sapUiMediumMargin">

                <Table
                    id="projectsTable"
                    mode="None"
                    inset="false"
                    sticky="ColumnHeaders"
                    growing="true"
                    growingThreshold="20"
                    growingScrollToLoad="true"
                    noDataText="No projects available"
                    items="{/PROJECTS}">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title
                                text="Project List"
                                level="H3" />

                            <ToolbarSpacer />

                            <SearchField
                                width="18rem"
                                placeholder="Search by Project ID or Name"
                                liveChange=".onProjectSearch" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="8rem">
                            <Text text="Project ID" />
                        </Column>

                        <Column >
                            <Text text="Project Name" />
                        </Column>

                        <!-- <Column>
                            <Text text="Description" />
                        </Column> -->

                        <Column>
                            <Text text="Start Date" />
                        </Column>

                        <Column>
                            <Text text="End Date" />
                        </Column>

                        <Column>
                            <Text text="Status" />
                        </Column>

                        <Column>
                            <Text text="View" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Active"
                            press=".onViewProject">

                            <cells>
                                <ObjectIdentifier
                                    title="{PROJECT_ID}" />

                                <Text
                                    text="{PROJECT_NAME}" />

                                <Text
                                    text="{START_DATE}"
                                    textAlign="Center" />

                                <Text
                                    text="{END_DATE}"
                                    textAlign="Center" />

                                <ObjectStatus
                                    text="{STATUS}"
                                    state="{=
                                        ${STATUS} === 'ACTIVE' ? 'Success' :
                                        ${STATUS} === 'ON_HOLD' ? 'Warning' :
                                        ${STATUS} === 'COMPLETED' ? 'Information' :
                                        ${STATUS} === 'CANCELLED' ? 'Error' :
                                        'None'
                                    }" />

                                <Button
                                    icon="sap-icon://display"
                                    type="Transparent"
                                    tooltip="View Project Details"
                                    press=".onViewProject" />
                            </cells>

                        </ColumnListItem>
                    </items>

                </Table>

            </VBox>
        </content>

    </Page>

</mvc:View>