<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="com.amista.worksyncui.controller.admin.Allocations"
    xmlns:core="sap.ui.core">
<Page id="allocationsPage" title="Allocations">
                    <content>
                        <VBox class="sapUiMediumMargin">
                            <Table id="allocationsTable" inset="false" sticky="ColumnHeaders" growing="true" growingThreshold="20" growingScrollToLoad="true" noDataText="No allocations available" items="{
                    path: '/ALLOCATIONS',
                    parameters: {
                        $expand: 'employee,project'
                    }
                }">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="Allocation List" level="H3" />

                                        <ToolbarSpacer />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="9rem">
                                        <Text text="Allocation ID" />
                                    </Column>

                                    <Column width="16rem">
                                        <Text text="Employee" />
                                    </Column>

                                    <Column width="16rem">
                                        <Text text="Project" />
                                    </Column>

                                    <Column width="9rem" hAlign="Center">
                                        <Text text="Allocation" />
                                    </Column>

                                    <Column width="9rem" hAlign="Center">
                                        <Text text="Start Date" />
                                    </Column>

                                    <Column width="9rem" hAlign="Center">
                                        <Text text="End Date" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{ALLOCATION_ID}" />

                                            <Text text="{employee/NAME}" />

                                            <Text text="{project/PROJECT_NAME}" />

                                            <ProgressIndicator width="10rem" percentValue="{ALLOCATION_PERCENTAGE}" displayValue="{ALLOCATION_PERCENTAGE}%" state="{=
                                    ${ALLOCATION_PERCENTAGE} >= 100 ? 'Error' :
                                    ${ALLOCATION_PERCENTAGE} >= 80 ? 'Warning' :
                                    'Success'
                                }" />

                                            <Text text="{START_DATE}" textAlign="Center" />

                                            <Text text="{END_DATE}" textAlign="Center" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </content>
                </Page>
</mvc:View>