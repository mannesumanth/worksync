<mvc:View controllerName="com.amista.worksyncui.controller.admin.Forecast"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:fc="sap.f"
	xmlns:card="sap.f.cards">
	<Page id="forecastPage" title="Resource Forecast">
		<content>
			<VBox class="sapUiMediumMargin">
				<!-- Header -->

				<Title text="Resource Forecast" level="H2" />

				<Text text="Current and upcoming employee availability" />
				<!-- Summary -->
				<HBox wrap="Wrap" justifyContent="SpaceBetween" class="sapUiMediumMarginBottom sapUiSmallMarginTop">
					<fc:Card width="15rem" height="10rem">
						<fc:header>
							<card:NumericHeader title="Available Employees" subtitle="Current Month" number="{summary>/available}" />
						</fc:header>
					</fc:Card>

					<fc:Card width="15rem" height="10rem">
						<fc:header>
							<card:NumericHeader title="Employees On Bench" subtitle="No Allocation (Available)" number="{summary>/bench}" />
						</fc:header>
					</fc:Card>

					<fc:Card width="15rem" height="10rem">
						<fc:header>
							<card:NumericHeader title="Employees On Leave" subtitle="Unavailable" number="{summary>/leave}" />
						</fc:header>
					</fc:Card>

					<fc:Card width="15rem" height="10rem">
						<fc:header>
							<card:NumericHeader title="Utilization" subtitle="Current Month" number="{summary>/utilization}" unitOfMeasurement="%" />
						</fc:header>
					</fc:Card>
				</HBox>
				<!-- Search -->
				<OverflowToolbar>
					<SearchField id="forecastSearch" width="18rem" placeholder="Search Employee" liveChange="onForecastSearch" />

					<ToolbarSpacer />

					<Select id="statusFilter" width="12rem" change="onStatusFilter">
						<items>
							<core:Item key="" text="All Status" />
							<core:Item key="AVAILABLE" text="Available" />
							<core:Item key="BENCH" text="Bench" />
							<core:Item key="On Leave" text="On Leave" />
						</items>
					</Select>
				</OverflowToolbar>
				<Table id="forecastTable" inset="false" growing="true" growingThreshold="20" growingScrollToLoad="true" sticky="ColumnHeaders" items="{forecast>/value}" class="sapUiMediumMarginTop">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Employee Forecast" level="H3" />
							<ToolbarSpacer />
							<Text text="{= ${forecast>/value}.length + ' Employees'}" />
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column >
							<Text text="Employee" />
						</Column>
						<Column >
							<Text text="Designation" />
						</Column>
						<Column >
							<Text text="Current Allocation" />
						</Column>
						<Column >
							<Text text="Available" />
						</Column>
						<Column >
							<Text text="Projects" />
						</Column>
						<Column>
							<Text text="Status" />
						</Column>
						<Column >
							<Text text="Next Available" />
						</Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press="onForecastPress">
							<cells>
								<!-- Employee -->
								<ObjectIdentifier title="{forecast>NAME}" text="{forecast>EMP_ID}" />
								<!-- Designation -->
								<Text text="{forecast>DESIGNATION}" />
								<!-- Allocation -->
								<VBox>
									<ProgressIndicator percentValue="{forecast>CURRENT_ALLOCATION}" displayValue="{forecast>CURRENT_ALLOCATION}%" state="Success" />
								</VBox>
								<!-- Available -->
								<VBox>
									<ProgressIndicator width="9rem" percentValue="{forecast>AVAILABLE_PERCENT}" displayValue="{forecast>AVAILABLE_PERCENT}%" state="{=
                                    ${AVAILABLE_PERCENT} >= 100 ? 'Error' :
                                    ${AVAILABLE_PERCENT} >= 80 ? 'Warning' :
                                    'Success'
                                    }" />
								</VBox>
								<!-- Projects -->
								<ObjectNumber number="{forecast>CURRENT_PROJECT_COUNT}" unit="Projects" />
								<!-- Status -->
								<ObjectStatus text="{forecast>CURRENT_STATUS}" state="{
                                        = ${forecast>CURRENT_STATUS} === 'Available'
                                        ? 'Success'
                                        : ${forecast>CURRENT_STATUS} === 'Bench'
                                        ? 'Information'
                                        : ${forecast>CURRENT_STATUS} === 'On Leave'
                                        ? 'Warning'
                                        : 'Error'
                                        }" />
								<!-- Next Available -->
								<ObjectIdentifier title="{forecast>NEXT_AVAILABLE_DATE}" text="Availability" />
								<!-- Acton -->
								<Button icon="sap-icon://inspect" type="Transparent" tooltip="View Forecast" press="onForecastPress" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>