<mvc:View
    controllerName="com.amista.worksyncui.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <tnt:ToolPage id="adminToolPage">
        <tnt:header>
            <OverflowToolbar>
                <Button
                    id="btnToggleNav"
                    icon="sap-icon://menu2"
                    type="Transparent"
                    tooltip="Toggle Navigation"
                    press="onToggleSideNavigation"/>

                <core:Icon
                    src="sap-icon://business-suite"
                    size="1.5rem"/>

                <Title
                    text="WORKSYNC "
                    level="H2"
                    class="sapUiTinyMarginBegin"/>
                <ToolbarSpacer />
                <!-- <ToggleButton
                    id="themeToggle"
                    text="Dark Mode"
                    icon="sap-icon://dark-mode"
                    press="onThemeToggle"/>   -->
            </OverflowToolbar>
        </tnt:header>

        <!-- Side Navigation -->
        <tnt:sideContent>
            <tnt:SideNavigation
                id="sideNavigation"
                itemSelect="onNavSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem
                        key="dashboard"
                        text="Dashboard"
                        icon="sap-icon://home"/>

                    <tnt:NavigationListItem
                        text="Master Data"
                        icon="sap-icon://database" >
                        <tnt:NavigationListItem
                            key="employees"
                            text="Employees"
                            icon="sap-icon://employee"/>

                        <tnt:NavigationListItem
                            key="designations"
                            text="Designations"
                            icon="sap-icon://manager" />

                        <tnt:NavigationListItem
                            key="skills"
                            text="Skills"
                            icon="sap-icon://competitor"/>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="Projects"
                        icon="sap-icon://project-definition-triangle-2">
                        <tnt:NavigationListItem
                            key="projects"
                            text="Projects"
                            icon="sap-icon://project-definition-triangle-2" />

                        <tnt:NavigationListItem
                            key="allocations"
                            text="Allocations"
                            icon="sap-icon://business-objects-experience" />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="Leave Management"
                        icon="sap-icon://calendar">
                        <tnt:NavigationListItem
                            key="leave"
                            text="Leave Calendar"
                            icon="sap-icon://calendar"/>
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="Analytics"
                        icon="sap-icon://line-chart">
                        <tnt:NavigationListItem
                            key="forecast"
                            text="Forecast"
                            icon="sap-icon://line-chart" />

                        <tnt:NavigationListItem
                            key="spof"
                            text="SPOF Risks"
                            icon="sap-icon://alert" />
                  
                    
                        <tnt:NavigationListItem
                            key="graphs"
                            text="GRAPHS"
                            icon="sap-icon://alert" />
                    </tnt:NavigationListItem>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <!-- Main Content -->

        <tnt:mainContents>
            <NavContainer
                id="adminNavContainer"
                width="100%"
                height="100%"
                initialPage="dashboardView">
                <mvc:XMLView
                    id="dashboardView"
                    viewName="com.amista.worksyncui.view.Dashboard"/>
                <mvc:XMLView
                    id="employeesView"
                    viewName="com.amista.worksyncui.view.Employees"/>

                <mvc:XMLView
                    id="designationsView"
                    viewName="com.amista.worksyncui.view.Designations" />

                <mvc:XMLView
                    id="skillsView"
                    viewName="com.amista.worksyncui.view.Skills"/>

                <mvc:XMLView
                    id="projectsView"
                    viewName="com.amista.worksyncui.view.Projects"/>

                <mvc:XMLView
                    id="allocationsView"
                    viewName="com.amista.worksyncui.view.Allocations"/>

                <mvc:XMLView
                    id="leaveView"
                    viewName="com.amista.worksyncui.view.LeaveCalender" />

                <mvc:XMLView
                    id="forecastView"
                    viewName="com.amista.worksyncui.view.Forecast"/>

                <mvc:XMLView
                    id="spofView"
                    viewName="com.amista.worksyncui.view.Spof"/>

                <mvc:XMLView 
                    id = "adminEmployeeDetail"
                    viewName = "com.amista.worksyncui.view.AdminEmployeeDetail"/>
                
                <mvc:XMLView
                    id = "adminProjectDetail"
                    viewName = "com.amista.worksyncui.view.ProjectDetail"/>
                <mvc:XMLView 
                    id = "graphsView"
                    viewName = "com.amista.worksyncui.view.Graphs"/>
            </NavContainer>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>

