<mvc:View
    controllerName="com.amista.worksyncui.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    displayBlock="true"
    xmlns:layout="sap.ui.layout"
>
    <tnt:ToolPage id="adminToolPage">
        <!-- SIDE NAVIGATION-->
        <tnt:sideContent>
            <tnt:SideNavigation itemSelect=".onNavSelect">
                <tnt:NavigationList>
                    <tnt:NavigationListItem
                        text="Dashboard"
                        icon="sap-icon://home"
                        key="dashboard"
                    />

                    <tnt:NavigationListItem
                        text="Master Data"
                        icon="sap-icon://database"
                    >
                        <tnt:NavigationListItem
                            text="Employees"
                            icon="sap-icon://employee"
                            key="employees"
                        />

                        <tnt:NavigationListItem
                            text="Designations"
                            icon="sap-icon://manager"
                            key="designations"
                        />

                        <tnt:NavigationListItem
                            text="Skill Categories"
                            icon="sap-icon://group"
                            key="skillCategories"
                        />

                        <tnt:NavigationListItem
                            text="Skills"
                            icon="sap-icon://competitor"
                            key="skills"
                        />

                        <tnt:NavigationListItem
                            text="Employee Skills"
                            icon="sap-icon://education"
                            key="employeeSkills"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="Projects"
                        icon="sap-icon://project-definition-triangle-2"
                    >
                        <tnt:NavigationListItem
                            text="Projects"
                            icon="sap-icon://project-definition-triangle-2"
                            key="projects"
                        />

                        <tnt:NavigationListItem
                            text="Allocations"
                            icon="sap-icon://business-objects-experience"
                            key="allocations"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="Leave Management"
                        icon="sap-icon://calendar"
                    >
                        <tnt:NavigationListItem
                            text="Leave Calendar"
                            icon="sap-icon://calendar"
                            key="leave"
                        />
                    </tnt:NavigationListItem>

                    <tnt:NavigationListItem
                        text="Analytics"
                        icon="sap-icon://business-objects-experience"
                    >
                        <tnt:NavigationListItem
                            text="SPOF Risks"
                            icon="sap-icon://alert"
                            key="spof"
                        />
                    </tnt:NavigationListItem>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <!-- MAIN CONTENT — NavContainer -->

        <tnt:mainContents>
            <NavContainer id="adminNavContainer">
                <!-- DASHBOARD PAGE -->
                <Page
                    id="dashboardPage"
                    title="Dashboard"
                    showHeader="true"
                >
                    <content>
                        <HBox
                            wrap="Wrap"
                            class="sapUiMediumMargin"
                        >
                            <GenericTile
                                header="Employees"
                                subheader="Total Headcount"
                                press="onTilePress"
                            >
                                <customData>
                                    <core:CustomData
                                        key="nav"
                                        value="employees"
                                    />
                                </customData>
                                <TileContent>
                                    <NumericContent
                                        id="tileEmpCount"
                                        value="0"
                                        icon="sap-icon://employee"
                                    />
                                </TileContent>
                            </GenericTile>
                            <GenericTile
                                header="Projects"
                                subheader="Active Projects"
                                press="onTilePress"
                            >
                                <customData>
                                    <core:CustomData
                                        key="nav"
                                        value="projects"
                                    />
                                </customData>
                                <TileContent>
                                    <NumericContent
                                        id="tileProjCount"
                                        value="0"
                                        icon="sap-icon://project-definition-triangle-2"
                                    />
                                </TileContent>
                            </GenericTile>
                            <GenericTile
                                header="Allocations"
                                subheader="Active Allocations"
                                press="onTilePress"
                            >
                                <customData>
                                    <core:CustomData
                                        key="nav"
                                        value="allocations"
                                    />
                                </customData>
                                <TileContent>
                                    <NumericContent
                                        id="tileAllocCount"
                                        value="0"
                                        icon="sap-icon://business-objects-experience"
                                    />
                                </TileContent>
                            </GenericTile>
                            <GenericTile
                                header="Leave Requests"
                                subheader="Pending Approvals"
                                press="onTilePress"
                            >
                                <customData>
                                    <core:CustomData
                                        key="nav"
                                        value="leave"
                                    />
                                </customData>
                                <TileContent>
                                    <NumericContent
                                        id="tileLeaveCount"
                                        value="0"
                                        icon="sap-icon://calendar"
                                    />
                                </TileContent>
                            </GenericTile>
                            <GenericTile
                                header=" Employees Available This Month"
                            >
                                <TileContent>
                                    <NumericContent
                                        value="{forecast>/currentMonthAvailable}"
                                        valueColor="Good"
                                    />
                                </TileContent>
                            </GenericTile>
                            <GenericTile
                                header="Employees Available Next Month"
                            >
                                <TileContent>
                                    <NumericContent
                                        value="{forecast>/nextMonthAvailable}"
                                        valueColor="Good"
                                    />
                                </TileContent>
                            </GenericTile>
                            <GenericTile
                                header="SPOF Risks"
                                subheader="Critical Skills"
                                press="onTilePress"
                            >
                                <customData>
                                    <core:CustomData
                                        key="nav"
                                        value="spof"
                                    />
                                </customData>
                                <TileContent>
                                    <NumericContent
                                        id="tileSpofCount"
                                        value="0"
                                        valueColor="Critical"
                                        icon="sap-icon://alert"
                                    />
                                </TileContent>
                            </GenericTile>
                            <GenericTile
                                header="Skills"
                                subheader="Registered Skills"
                                press="onTilePress"
                            >
                                <customData>
                                    <core:CustomData
                                        key="nav"
                                        value="skills"
                                    />
                                </customData>
                                <TileContent>
                                    <NumericContent
                                        id="tileSkillCount"
                                        value="0"
                                        icon="sap-icon://competitor"
                                    />
                                </TileContent>
                            </GenericTile>
                        </HBox>
                    </content>
                </Page>
                <!-- EMPLOYEES PAGE-->
                <Page
                    id="employeesPage"
                    title="Employees"
                    showHeader="true"
                >
                    <headerContent>
                        <Button
                            text="Add Employee"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="onAddEmployee"
                        />
                    </headerContent>
                    <content>
                        <Toolbar>
                            <SearchField
                                id="employeeSearch"
                                width="250px"
                                placeholder="Search by name / email / ID"
                                liveChange=".onEmployeeFilterChange"
                            />
                            <ToolbarSpacer />
                            <Select
                                id="statusFilter"
                                width="150px"
                                change=".onEmployeeFilterChange"
                            >
                                <core:Item
                                    key=""
                                    text="All Status"
                                />
                                <core:Item
                                    key="ACTIVE"
                                    text="Active"
                                />
                                <core:Item
                                    key="ONBOARDING"
                                    text="Onboarding"
                                />
                                <core:Item
                                    key="ON_LEAVE"
                                    text="On Leave"
                                />
                                <core:Item
                                    key="BENCH"
                                    text="Bench"
                                />
                                <core:Item
                                    key="RESIGNED"
                                    text="Resigned"
                                />
                                <core:Item
                                    key="TERMINATED"
                                    text="Terminated"
                                />
                            </Select>
                            <Input
                                id="experienceFilter"
                                width="130px"
                                placeholder="Min Exp (yrs)"
                                liveChange="onEmployeeFilterChange"
                            />
                        </Toolbar>
                        <Table
                            id="employeesTable"
                            mode="None"
                            noDataText="No employees found"
                            items="{
                                path: '/EMPLOYEES'
                            }"
                        >
                            <columns>
                                <Column>
                                    <Text text="EMP ID" />
                                </Column>
                                <Column>
                                    <Text text="Name" />
                                </Column>
                                <Column>
                                    <Text text="Email" />
                                </Column>
                                <Column>
                                    <Text text="Designation" />
                                </Column>
                                <Column>
                                    <Text text="Experience" />
                                </Column>
                                <Column>
                                    <Text text="Status" />
                                </Column>
                                <Column>
                                    <Text text="Allocation" />
                                </Column>
                                <Column>
                                    <Text text="View" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{EMP_ID}" />
                                        <Text text="{NAME}" />
                                        <Text text="{EMAIL}" />
                                        <Text text="{DESIGNATION/NAME}" />
                                        <Text text="{EXPERIENCE} yrs" />
                                        <ObjectStatus
                                            text="{STATUS}"
                                            state="{= ${STATUS} === 'ACTIVE' ? 'Success' :
                                                ${STATUS} === 'ON_LEAVE' ? 'Warning' :
                                                ${STATUS} === 'BENCH' ? 'Information' : 'Error'}"
                                        />
                                        <ProgressIndicator
                                            width="8rem"
                                            percentValue="{ALLOCATION_PERCENT}"
                                            displayValue="{ALLOCATION_PERCENT}%"
                                            state="{= ${ALLOCATION_PERCENT} >= 100 ? 'Error' :
                                                ${ALLOCATION_PERCENT} >= 80  ? 'Warning' : 'Success'}"
                                        />
                                        <Button
                                            icon="sap-icon://display"
                                            tooltip="View"
                                            press="onViewEmployee"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>
                <!-- DESIGNATIONS PAGE                   -->
                <Page
                    id="designationsPage"
                    title="Designations"
                >
                    <headerContent>
                        <Button
                            text="Add"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onOpenDesignationDialog"
                        />
                    </headerContent>
                    <content>
                        <Table
                            items="{/DESIGNATIONS}"
                            id="designationsTable"
                        >
                            <columns>
                                <Column>
                                    <Text text="Designation ID" />
                                </Column>
                                <Column>
                                    <Text text="Name" />
                                </Column>
                                <Column>
                                    <Text text="Level" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{DESIGNATION_ID}" />
                                        <Text text="{NAME}" />
                                        <Text text="{LEVEL}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>
                <!-- SKILL CATEGORIES PAGE               -->
                <Page
                    id="skillCategoriesPage"
                    title="Skill Categories"
                >
                    <headerContent>
                        <Button
                            text="Add"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onOpenSkillCategoryDialog"
                        />
                        <Button
                            text="Delete"
                            icon="sap-icon://delete"
                            type="Negative"
                            press="onDeleteSkillCategory"
                        />
                    </headerContent>
                    <content>
                        <Table
                            id="skillCategoriesTable"
                            mode="SingleSelectLeft"
                            items="{/SKILL_CATEGORIES}"
                        >
                            <columns>
                                <Column>
                                    <Text text="Category ID" />
                                </Column>
                                <Column>
                                    <Text text="Category Name" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{CAT_ID}" />
                                        <Text text="{CATEGORY_NAME}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>
                <!-- SKILLS PAGE                         -->
                <Page
                    id="adminskillsPage"
                    title="Skills"
                >
                    <headerContent>
                        <Button
                            text="Add"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="onOpenSkillDialog"
                        />
                        <Button
                            text="Delete"
                            icon="sap-icon://delete"
                            type="Negative"
                            press="onDeleteSkill"
                        />
                    </headerContent>
                    <content>
                        <Table
                            id="skillsTable"
                            mode="SingleSelectLeft"
                            items="{
                                path: '/SKILLS',
                                parameters: {
                                    $expand: 'category'
                                }
                            }"
                        >
                            <columns>
                                <Column>
                                    <Text text="Skill ID" />
                                </Column>
                                <Column>
                                    <Text text="Skill Name" />
                                </Column>
                                <Column>
                                    <Text text="Category" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{SKILL_ID}" />
                                        <Text text="{SKILL_NAME}" />
                                        <Text text="{category/CATEGORY_NAME}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>
                <!-- EMPLOYEE SKILLS PAGE                -->
                <Page
                    id="employeeSkillsPage"
                    title="Employee Skills"
                >
                    <content>
                        <Table items="{empSkills>/employees}">
                            <columns>
                                <Column>
                                    <Text text="EMP ID" />
                                </Column>
                                <Column>
                                    <Text text="Name" />
                                </Column>
                                <Column>
                                    <Text text="Skills" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{empSkills>EMP_ID}" />
                                        <Text text="{empSkills>NAME}" />
                                        <Text text="{empSkills>skillsText}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>
                <!-- PROJECTS PAGE                       -->
                <Page
                    id="adminprojectsPage"
                    title="Projects"
                >
                    <headerContent>
                        <Button
                            text="Create Project"
                            icon="sap-icon://add"
                            type="Transparent"
                            press="onCreateProject"
                        />
                    </headerContent>
                    <content>
                        <VBox class="sapUiSmallMargin">
                            <!-- Projects Table -->
                            <Table
                                id="projectsTable"
                                mode="None"
                                growing="true"
                                growingScrollToLoad="true"
                                items="{/PROJECTS}"
                            >
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title
                                            text="Project List"
                                            level="H3"
                                        />
                                        <ToolbarSpacer />
                                        <SearchField
                                            width="250px"
                                            liveChange=".onProjectSearch"
                                            placeholder="Search Projects"
                                        />
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="8rem">
                                        <Text text="Project ID" />
                                    </Column>
                                    <Column minScreenWidth="Tablet">
                                        <Text text="Project Name" />
                                    </Column>
                                    <Column minScreenWidth="Tablet">
                                        <Text text="Project Description" />
                                    </Column>
                                    <Column width="8rem">
                                        <Text text="Start Date" />
                                    </Column>
                                    <Column width="8rem">
                                        <Text text="End Date" />
                                    </Column>
                                    <Column width="8rem">
                                        <Text text="Status" />
                                    </Column>
                                    <Column
                                        width="5rem"
                                        hAlign="Center"
                                    >
                                        <Text text="Actions" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem
                                        type="Active"
                                        press="onViewProject"
                                    >
                                        <cells>
                                            <ObjectIdentifier
                                                title="{PROJECT_ID}"
                                            />
                                            <Text text="{PROJECT_NAME}" />
                                            <Text text="{DESCRIPTION}" />
                                            <Text text="{START_DATE}" />
                                            <Text text="{END_DATE}" />
                                            <ObjectStatus
                                                text="{STATUS}"
                                                state="{=${STATUS} === 'ACTIVE' ? 'Success' :${STATUS} === 'ON_HOLD' ? 'Warning' :${STATUS} === 'COMPLETED' ? 'Information' :${STATUS} === 'CANCELLED' ? 'Error' :'None'}"
                                            />
                                            <Button
                                                icon="sap-icon://display"
                                                type="Transparent"
                                                tooltip="View Project"
                                                press="onViewProject"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </content>
                </Page>
                <!-- ALLOCATIONS PAGE                    -->
                <Page
                    id="allocationsPage"
                    title="Allocations"
                >
                    <content>
                        <Table
                            items="{
                            path: '/ALLOCATIONS',
                            parameters: {
                                $expand: 'employee,project'
                            }
                        }"
                        >
                            <columns>
                                <Column>
                                    <Text text="Allocation ID" />
                                </Column>
                                <Column>
                                    <Text text="Employee" />
                                </Column>
                                <Column>
                                    <Text text="Project" />
                                </Column>
                                <Column>
                                    <Text text="%" />
                                </Column>
                                <Column>
                                    <Text text="Start Date" />
                                </Column>
                                <Column>
                                    <Text text="End Date" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{ALLOCATION_ID}" />
                                        <Text text="{employee/NAME}" />
                                        <Text text="{project/PROJECT_NAME}" />
                                        <Text text="{ALLOCATION_PERCENTAGE}%" />
                                        <Text text="{START_DATE}" />
                                        <Text text="{END_DATE}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>

                <!-- LEAVE CALENDAR PAGE  -->

                <Page
                    id="leavePage"
                    title="Leave Calendar"
                >
                    <content>
                        <Table
                            items="{
                            path: '/LEAVE_CALENDAR',
                            parameters: {
                                $expand: 'employee',
                                $orderby: 'createdAt desc'
                            }
                        }"
                        >
                            <columns>
                                <Column>
                                    <Text text="Leave ID" />
                                </Column>
                                <Column>
                                    <Text text="Employee" />
                                </Column>
                                <Column>
                                    <Text text="Type" />
                                </Column>
                                <Column>
                                    <Text text="From" />
                                </Column>
                                <Column>
                                    <Text text="To" />
                                </Column>
                                <Column>
                                    <Text text="Status" />
                                </Column>
                                <Column>
                                    <Text text="Actions" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{LEAVE_ID}" />
                                        <Text text="{employee/NAME}" />
                                        <Text text="{LEAVE_TYPE}" />
                                        <Text text="{LEAVE_FROM}" />
                                        <Text text="{LEAVE_TO}" />

                                        <ObjectStatus
                                            text="{STATUS}"
                                            state="{= ${STATUS} === 'APPROVED' ? 'Success' :
                    ${STATUS} === 'REJECTED' ? 'Error' :
                    ${STATUS} === 'PENDING' ? 'Warning' :
                    'None'}"
                                        />

                                        <Select
                                            selectedKey="{STATUS}"
                                            change="onLeaveStatusChange"
                                            width="140px"
                                        >
                                            <items>
                                                <core:Item
                                                    key="APPROVED"
                                                    text="Approve"
                                                />
                                                <core:Item
                                                    key="REJECTED"
                                                    text="Reject"
                                                />
                                            </items>
                                        </Select>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>
                <!-- Placeholder for SPOF Risks -->
                <Page
                    id="spofPage"
                    title="SPOF Risks"
                >
                    <content>
                        <Table
                            inset="false"
                            items="{spof>/risks}"
                        >
                            <headerToolbar>
                                <Toolbar>
                                    <Title
                                        text="Single Point Of Failure Risks"
                                    />
                                    <ToolbarSpacer />
                                    <ObjectStatus
                                        text="{= ${spof>/risks}.length + ' Risks Found'}"
                                        state="Warning"
                                    />
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column>
                                    <Text text="Skill" />
                                </Column>
                                <Column>
                                    <Text text="Employee" />
                                </Column>
                                <Column>
                                    <Text text="Employee ID" />
                                </Column>
                                <Column>
                                    <Text text="Risk Level" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <ObjectIdentifier
                                            title="{spof>SKILL_NAME}"
                                        />
                                        <ObjectIdentifier
                                            title="{spof>EMPLOYEE_NAME}"
                                        />
                                        <Text text="{spof>EMP_ID}" />
                                        <ObjectStatus
                                            text="{spof>RISK_LEVEL}"
                                            state="{
                                                path: 'spof>RISK_LEVEL',
                                                formatter: '.riskStateFormatter'
                                            }"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Page>
            </NavContainer>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
