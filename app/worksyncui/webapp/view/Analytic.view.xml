<mvc:View
    controllerName="com.amista.worksyncui.controller.Analytic"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:viz="sap.viz.ui5.controls"
>
    <Page
        title="Analytics Dashboard"
        showHeader="false"
    >
        <VBox
            width="100%"
            class="sapUiMediumMargin"
        >
            <!-- HEADER -->

            <Title
                text="Analytics Dashboard"
                level="H2"
            />

            <Text
                text="Visualize employee, project and utilization analytics."
                class="sapUiSmallMarginBottom"
            />

            <!-- FILTER BAR -->
            <Toolbar>
                <Label text="Graph" />

                <Select
                    id="graphSelector"
                    
                    selectedKey="employees"
                    change="onGraphChange"
                >
                    <core:Item
                        key="employees"
                        text="Employee Allocation"
                    />

                    <core:Item
                        key="projects"
                        text="Projects"
                    />

                    <core:Item
                        key="leaves"
                        text="Leaves"
                    />

                    <core:Item
                        key="skills"
                        text="Skills"
                    />

                    <core:Item
                        key="utilization"
                        text="Utilization"
                    />
                </Select>

                <ToolbarSpacer />

                <Button
                    icon="sap-icon://refresh"
                    text="Refresh"
                />
            </Toolbar>
            <!-- KPI CARDS -->

            <HBox
                justifyContent="SpaceAround"
                class="sapUiMediumMarginTop"
            >
                <GenericTile
                    header="Employees"
                    subheader="Total"
                >
                    <TileContent>
                        <NumericContent value="0" />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    header="Projects"
                    subheader="Active"
                >
                    <TileContent>
                        <NumericContent value="0" />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    header="Allocation"
                    subheader="Average"
                >
                    <TileContent>
                        <NumericContent
                            value="0"
                            scale="%"
                        />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    header="Leaves"
                    subheader="Current Month"
                >
                    <TileContent>
                        <NumericContent value="0" />
                    </TileContent>
                </GenericTile>
            </HBox>

            <!-- CHART -->

            <Panel
                headerText="Analytics"
                expandable="false"
                class="sapUiMediumMarginTop"
            >
                <VBox
                    justifyContent="Center"
                    alignItems="Center"
                    height="500px"
                >
                    <viz:VizFrame
                        id="analyticsChart"
                        uiConfig="{applicationSet:'fiori'}"
                        width="100%"
                        height="450px"
                    />
                </VBox>
            </Panel>
        </VBox>
    </Page>
</mvc:View>
