<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog
        id="addEmployeeDialog"
        title="Add Employee"
        contentWidth="520px">
        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4">
                <Label
                    text="Employee Name"
                    required="true"/>
                <Input
                    id="empName"
                    placeholder="Full Name"
                    required="true"
                    liveChange=".onFieldChange"/>
                <Label
                    text="Email"
                    required="true"/>
                <Input
                    id="empEmail"
                    type="Email"
                    placeholder="email@company.com"
                    required="true"
                    liveChange=".onFieldChange"/>

                <Label
                    text="Phone Number"
                    required="true"/>
                <Input
                    id="empPhone"
                    type="Tel"
                    maxLength="10"
                    placeholder="10-digit number"
                    required="true"
                    liveChange=".onFieldChange"/>
                <Label
                    text="Date of Birth"
                    required="true"/>
                <DatePicker
                    id="empDob"
                    displayFormat="dd/MM/yyyy"
                    required="true"
                    change=".onFieldChange"/>
                <Label
                    text="Gender"
                    required="true" />

                <Select
                    id="empGender"
                    required="true"
                    selectedKey="">
                    <core:Item
                        key=""
                        text="Select Gender"
                        enabled="false"/>
                    <core:Item
                        key="MALE"
                        text="Male"/>
                    <core:Item
                        key="FEMALE"
                        text="Female"/>
                    <core:Item
                        key="OTHER"
                        text="Other"/>
                </Select>
                <Label
                    text="Joining Date"
                    required="true"/>
                <DatePicker
                    id="empJoiningDate"
                    displayFormat="dd/MM/yyyy"
                    required="true"/>
                <Label
                    text="Experience (years)"
                    required="true" />
                <Input
                    id="empExperience"
                    type="Number"
                    placeholder="e.g. 3.5"
                    change=".onFieldChange"
                    required="true"/>
                <Label text="Status" />
                <Select
                    id="empStatus"
                    change=".onFieldChange"
                    selectedKey=""
                    required = "true" >
                    <core:Item 
                        key = "SELECT"
                        text = "Select status"
                       />
                    <core:Item
                        key="ACTIVE"
                        text="Active"/>
                </Select>
                <Label
                    text="Designation"
                    required="true" />
                <Select
                    id="empDesignation"
                    required="true"
                    items="{designationModelED>/designations}">
                    <core:Item
                        key="{designationModelED>ID}"
                        text="{designationModelED>NAME}" />
                </Select>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveEmployee" />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelEmployee" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
