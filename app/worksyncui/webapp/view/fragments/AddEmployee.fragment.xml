<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="addEmployeeDialog"
        title="Add Employee"
        contentWidth="520px"
    >
        <content>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
            >
                <Label
                    text="Employee Name"
                    required="true"
                />
                <Input
                    id="empName"
                    placeholder="Full Name"
                    required="true"
                />
                <Label
                    text="Email"
                    required="true"
                />
                <Input
                    id="empEmail"
                    type="Email"
                    placeholder="email@company.com"
                    required="true"
                />
                <Label
                    text="Phone Number"
                    required="true"
                />
                <Input
                    id="empPhone"
                    type="Tel"
                    placeholder="10-digit number"
                    required="true"
                />
                <Label
                    text="Date of Birth"
                    required="true"
                />
                <DatePicker
                    id="empDob"
                    displayFormat="dd/MM/yyyy"
                    required="true"
                />
                <Label
                    text="Joining Date"
                    required="true"
                />
                <DatePicker
                    id="empJoiningDate"
                    displayFormat="dd/MM/yyyy"
                    required="true"
                />
                <Label
                    text="Experience (years)"
                    required="true"
                />
                <Input
                    id="empExperience"
                    type="Number"
                    placeholder="e.g. 3.5"
                    required="true"
                />
                <Label text="Role" />
                <Select
                    id="empRole"
                    selectedKey="EMPLOYEE"
                >
                    <core:Item
                        key="EMPLOYEE"
                        text="Employee"
                    />
                    <core:Item
                        key="ADMIN"
                        text="Admin"
                    />
                </Select>
                <!--
                    FIX: Replaced invalid 'INACTIVE' with correct enum values from schema:
                    ONBOARDING | ACTIVE | ON_LEAVE | BENCH | RESIGNED | TERMINATED
                -->
                <Label text="Status" />
                <Select
                    id="empStatus"
                    selectedKey="ACTIVE"
                >
                    <core:Item
                        key="ONBOARDING"
                        text="Onboarding"
                    />
                    <core:Item
                        key="ACTIVE"
                        text="Active"
                    />
                    <core:Item
                        key="ON_LEAVE"
                        text="On Leave"
                    />
                    <core:Item
                        key="BENCH"
                        text="Bench"
                    />
                    <core:Item
                        key="RESIGNED"
                        text="Resigned"
                    />
                    <core:Item
                        key="TERMINATED"
                        text="Terminated"
                    />
                </Select>
                <Label
                    text="Designation"
                    required="true"
                />
                <Select
                    id="empDesignation"
                    required="true"
                    items="{/DESIGNATIONS}"
                >
                    <core:Item
                        key="{ID}"
                        text="{NAME}"
                    />
                </Select>
                <Label text="Skills" />
                <MultiComboBox
                    id="empSkills"
                    items="{/SKILLS}"
                    placeholder="Select skills..."
                >
                    <core:Item
                        key="{ID}"
                        text="{SKILL_NAME}"
                    />
                </MultiComboBox>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveEmployee"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelEmployee"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
