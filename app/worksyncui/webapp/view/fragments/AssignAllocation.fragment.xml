<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="assignAllocationDialog"
        title="Assign Employee"
        contentWidth="450px"
    >
        <VBox class="sapUiMediumMargin">
            <Label
                text="Employee"
                required="true"
            />

            <ComboBox
                id="allocationEmployee"
                width="100%"
                items="{
        path: '/EMPLOYEES'
    }"
            >
                <core:Item
                    key="{ID}"
                    text="{NAME}"
                />
            </ComboBox>
            <Label
                text="Project Role"
                required="true"
                class="sapUiSmallMarginTop"
            />

            <Input
                id="allocationRole"
                placeholder="Backend Developer"
            />

            <Label
                text="Allocation Percentage"
                required="true"
                class="sapUiSmallMarginTop"
            />

            <StepInput
                id="allocationPercent"
                value="25"
                min="1"
                max="100"
                step="5"
            />

            <Label
                text="Start Date"
                required="true"
                class="sapUiSmallMarginTop"
            />

            <DatePicker
                id="allocationStartDate"
                width="100%"
            />

            <Label
                text="End Date"
                required="true"
                class="sapUiSmallMarginTop"
            />

            <DatePicker
                id="allocationEndDate"
                width="100%"
            />
        </VBox>

        <beginButton>
            <Button
                text="Assign"
                type="Emphasized"
                press=".onSaveAllocation"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseAssignAllocation"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
