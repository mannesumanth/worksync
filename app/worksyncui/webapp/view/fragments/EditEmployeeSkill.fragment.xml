<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="editEmployeeSkillDialog"
        title="Edit Employee Skill"
        contentWidth="30rem">

        <content>

            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout">

                <Label text="Skill"/>

                <Input
                    value="{editSkill>/skill/SKILL_NAME}"
                    editable="false"/>

                <Label text="Proficiency"/>

                <Select
                    selectedKey="{editSkill>/PROFICIENCY_LEVEL}">

                    <core:Item
                        key="BEGINNER"
                        text="Beginner"/>

                    <core:Item
                        key="INTERMEDIATE"
                        text="Intermediate"/>

                    <core:Item
                        key="ADVANCED"
                        text="Advanced"/>

                    <core:Item
                        key="EXPERT"
                        text="Expert"/>

                </Select>

            </f:SimpleForm>

        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onUpdateEmployeeSkill"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelEmployeeSkill"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>