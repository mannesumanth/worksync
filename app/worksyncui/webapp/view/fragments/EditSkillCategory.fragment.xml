<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="editSkillCategoryDialog"
        title="Edit Skill Category"
        contentWidth="30rem">

        <content>

            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout">

                <Label text="Category ID"/>

                <Input
                    value="{editCategory>/CAT_ID}"
                    editable="false"/>

                <Label text="Category Name"/>

                <Input
                    value="{editCategory>/CATEGORY_NAME}"/>

            </f:SimpleForm>

        </content>

        <beginButton>
            <Button
                text="Update"
                type="Emphasized"
                press=".onUpdateSkillCategory"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelSkillCategory"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>