<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="editEmployeeDialog"
        title="Edit Employee"
        contentWidth="750px"
        contentHeight="450px"
        draggable="true"
        resizable="true"
    >
        <content>
            <VBox>
                <Panel
                    headerText="Employee Information"
                    expandable="false"
                >
                    <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                    >
                        <Label text="Employee ID" />
                        <Input
                            value="{edit>/EMP_ID}"
                            editable="false"
                        />

                        <Label text="Name" />
                        <Input
                            id="editName"
                            value="{edit>/NAME}"
                            liveChange=".onEditFieldChange"
                        />

                        <Label text="Email" />
                        <Input
                            id="editEmail"
                            value="{edit>/EMAIL}"
                            type="Email"
                            liveChange=".onEditFieldChange"
                        />

                        <Label text="Gender" />
                        <Select
                            id="editGender"
                            width="100%"
                            forceSelection="true"
                            selectedKey="{edit>/GENDER}"
                            change=".onEditFieldChange"
                        >
                            <core:Item
                                key="MALE"
                                text="Male"
                            />
                            <core:Item
                                key="FEMALE"
                                text="Female"
                            />
                            <core:Item
                                key="OTHER"
                                text="Other"
                            />
                        </Select>

                        <Label text="Phone" />
                        <Input
                            id="editPhone"
                            value="{edit>/PHONE_NUMBER}"
                            liveChange=".onEditFieldChange"
                        />

                        <Label text="Date of Birth" />
                        <DatePicker
                            id="editDob"
                            value="{edit>/DATE_OF_BIRTH}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                            change=".onEditFieldChange"
                        />

                        <Label text="Joining Date" />
                        <DatePicker
                            id="editJoiningDate"
                            value="{edit>/JOINING_DATE}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd/MM/yyyy"
                            change=".onEditFieldChange"
                        />

                        <Label text="Experience" />
                        <Input
                            id="editExperience"
                            value="{edit>/EXPERIENCE}"
                            type="Number"
                            liveChange=".onEditFieldChange"
                        />

                        <Label text="Designation" />
                        <Select
                            id="editDesignation"
                            width="100%"
                            items="{/DESIGNATIONS}"
                            selectedKey="{edit>/designation_ID}"
                            change=".onEditFieldChange"
                        >
                            <core:Item
                                key="{ID}"
                                text="{NAME}"
                            />
                        </Select>

                        <Label text="Status" />
                        <Select
                            id="editStatus"
                            width="100%"
                            selectedKey="{edit>/STATUS}"
                            change=".onEditFieldChange"
                        >
                            <core:Item
                                key="ACTIVE"
                                text="Active"
                            />

                            <core:Item
                                key="ON_LEAVE"
                                text="On Leave"
                            />

                            <core:Item
                                key="BENCH"
                                text="Bench"
                            />

                            <core:Item
                                key="RESIGNED"
                                text="Resigned"
                            />

                            <core:Item
                                key="TERMINATED"
                                text="Terminated"
                            />
                        </Select>
                    </f:SimpleForm>
                </Panel>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Update Employee"
                type="Emphasized"
                press=".onUpdateEmployee"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelEmployee"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
