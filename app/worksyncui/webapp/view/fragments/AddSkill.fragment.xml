<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="skillDialog"
        title="Add Skill"
        contentWidth="400px"
    >
        <VBox class="sapUiMediumMargin">
            <Label
                text="Skill Name"
                required="true"
            />
            <Input
                id="skillNameInput"
                placeholder="Java"
            />
            <Label
                text="Skill Category"
                required="true"
            />
            <ComboBox
                id="skillCategoryCombo"
                items="{/SKILL_CATEGORIES}"
            >
                <core:Item
                    key="{ID}"
                    text="{CATEGORY_NAME}"
                />
            </ComboBox>
        </VBox>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveSkill"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseSkill"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
