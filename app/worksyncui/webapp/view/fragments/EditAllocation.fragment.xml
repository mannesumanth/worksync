<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="editAllocationDialog"
        title="Edit Allocation"
        contentWidth="500px"
    >
        <content>

            <VBox class="sapUiMediumMargin">

                <!-- Project Information -->
                <Panel
                    headerText="Project Information"
                    class="sapUiSmallMarginBottom"
                >
                    <content>

                        <HBox
                            wrap="Wrap"
                            class="sapUiSmallMargin"
                        >

                            <VBox width="50%">
                                <Label text="Project Start Date" />

                                <Text
                                    id="editAllocationProjectStartDate"
                                />
                            </VBox>

                            <VBox width="50%">
                                <Label text="Project End Date" />

                                <Text
                                    id="editAllocationProjectEndDate"
                                />
                            </VBox>

                        </HBox>

                    </content>
                </Panel>


                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                >

                    <Label text="Employee"/>

                    <Input
                        value="{editAllocation>/employee/NAME}"
                        editable="false"
                    />

                    <Label text="Project Role"/>

                    <Input
                        value="{editAllocation>/PROJECT_ROLE}"
                    />

                    <Label text="Allocation Percentage"/>

                    <StepInput
                        value="{editAllocation>/ALLOCATION_PERCENTAGE}"
                        min="1"
                        max="100"
                        step="5"
                    />

                    <Label text="Start Date"/>

                    <DatePicker
                        value="{
                            path:'editAllocation>/START_DATE',
                            type:'sap.ui.model.odata.type.Date'
                        }"
                        valueFormat="yyyy-MM-dd"
                        displayFormat="dd MMM yyyy"
                    />

                    <Label text="End Date"/>

                    <DatePicker
                        value="{
                            path:'editAllocation>/END_DATE',
                            type:'sap.ui.model.odata.type.Date'
                        }"
                        valueFormat="yyyy-MM-dd"
                        displayFormat="dd MMM yyyy"
                    />

                </f:SimpleForm>

            </VBox>

        </content>

        <beginButton>
            <Button
                text="Update"
                type="Emphasized"
                press=".onUpdateAllocation"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCancelEditAllocation"
            />
        </endButton>

    </Dialog>
</core:FragmentDefinition>