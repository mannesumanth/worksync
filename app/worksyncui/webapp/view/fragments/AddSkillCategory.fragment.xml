<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="skillCategoryDialog"
        title="Add Skill Category"
        contentWidth="400px"
    >
        <VBox class="sapUiMediumMargin">
            <Label
                text="Category Name"
                required="true"
            />
            <Input
                id="categoryNameInput"
                placeholder="Programming Languages"
            />
        </VBox>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveSkillCategory"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseSkillCategory"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
