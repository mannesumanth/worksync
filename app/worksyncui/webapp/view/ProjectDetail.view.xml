<mvc:View
    controllerName="com.amista.worksyncui.controller.ProjectDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <Page
        title="Project Details"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <headerContent>
            <Button
                text="Edit Project"
                press=".onEditProjectPress"
                visible="{= ${path: 'STATUS', targetType: 'any'} !== 'COMPLETED' }"
            />
        </headerContent>
        <content>
            <!-- Project Header -->
            <ObjectHeader
                title="{PROJECT_NAME}"
                number="{PROJECT_ID}"
            >
                <statuses>
                    <ObjectStatus
                        text="{STATUS}"
                        state="{= ${STATUS} === 'ACTIVE'    ? 'Success' :
                            ${STATUS} === 'ON_HOLD'   ? 'Warning' : 'None'}"
                    />
                </statuses>
                <attributes>
                    <ObjectAttribute text="Manager: {manager/NAME}" />
                    <ObjectAttribute text="Start: {START_DATE}" />
                    <ObjectAttribute text="End: {END_DATE}" />
                </attributes>
            </ObjectHeader>

            <!-- Project Information -->
            <Panel
                headerText="Project Information"
                expandable="true"
                expanded="true"
            >
                <f:SimpleForm
                    editable="false"
                    layout="ResponsiveGridLayout"
                >
                    <Label text="Description" />
                    <Text text="{DESCRIPTION}" />
                    <Label text="Start Date" />
                    <Text text="{START_DATE}" />
                    <Label text="End Date" />
                    <Text text="{END_DATE}" />
                    <Label text="Status" />
                    <Text text="{STATUS}" />
                    <Label text="Project Manager" />
                    <Text text="{manager/NAME}" />
                </f:SimpleForm>
            </Panel>

            <!-- Required Skills -->
            <Panel
                headerText="Requirements &amp; Skills"
                expandable="true"
                visible="{= ${path: 'STATUS', targetType: 'any'} !== 'COMPLETED' }"
                expanded="true"
            >
                <Table
                    noDataText="No requirements defined"
                    items="{requirements}"
                    width="auto"
                    growing="true"
                    growingThreshold="10"
                    growingScrollToLoad="true"
                >
                    <columns>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        />
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <VBox>
                                    <!-- Nested table for required skills within each requirement -->
                                    <Table
                                        noDataText="No skills"
                                        items="{requirementSkills}"
                                        width="auto"
                                    >
                                        <columns>
                                            <Column
                                                width="35%"
                                                minScreenWidth="Tablet"
                                                demandPopin="true"
                                                popinDisplay="Inline"
                                                hAlign="Left"
                                                vAlign="Top"
                                            >
                                                <Text text="Skill" />
                                            </Column>
                                            <Column
                                                width="35%"
                                                minScreenWidth="Tablet"
                                                demandPopin="true"
                                                popinDisplay="Inline"
                                                hAlign="Left"
                                                vAlign="Top"
                                            >
                                                <Text text="Required Level" />
                                            </Column>
                                            <Column
                                                width="30%"
                                                minScreenWidth="Tablet"
                                                demandPopin="true"
                                                popinDisplay="Inline"
                                                hAlign="Left"
                                                vAlign="Top"
                                            >
                                                <Text text="Required Resources" />
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem>
                                                <cells>
                                                    <Text
                                                        text="{skill/SKILL_NAME}"
                                                        class="sapMTableContentMargin"
                                                    />
                                                    <Text
                                                        text="{REQUIRED_LEVEL}"
                                                        class="sapMTableContentMargin"
                                                    />
                                                    <Text
                                                        text="{REQUIRED_RESOURCES}"
                                                        class="sapMTableContentMargin"
                                                    />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </VBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <!-- Recommended Resources -->
            <Panel
                headerText="Recommended Resources"
                expandable="true"
                expanded="true"
                visible="{= ${path: 'STATUS', targetType: 'any'} !== 'COMPLETED' }"
            >
                <Table
                    items="{recommend>/resources}"
                    noDataText="No matching resources found"
                    width="auto"
                    growing="true"
                    growingThreshold="10"
                    growingScrollToLoad="true"
                >
                    <columns>
                        <Column
                            width="25%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Employee" />
                        </Column>
                        <Column
                            width="20%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Match Percent" />
                        </Column>
                        <Column
                            width="25%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Allocated" />
                        </Column>
                        <Column
                            width="30%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Available" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier
                                    class="sapMTableContentMargin"
                                    title="{recommend>NAME}"
                                    text="{recommend>EMP_ID}"
                                />
                                <ObjectNumber
                                    number="{recommend>MATCH_PERCENT}"
                                    class="sapMTableContentMargin"
                                />
                                <ProgressIndicator
                                    percentValue="{recommend>ALLOCATION_PERCENT}"
                                    displayValue="{recommend>ALLOCATION_PERCENT}%"
                                    class="sapMTableContentMargin"
                                />
                                <ProgressIndicator
                                    percentValue="{recommend>AVAILABLE_PERCENT}"
                                    displayValue="{recommend>AVAILABLE_PERCENT}%"
                                    class="sapMTableContentMargin"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <!-- Allocations -->
            <Panel
                expandable="true"
                expanded="true"
                class="sapUiMarginTopBottom"
                visible="{= ${path: 'STATUS', targetType: 'any'} !== 'COMPLETED' }"
            >
                <headerToolbar>
                    <Toolbar>
                        <Title text="Resource Allocations" />
                        <ToolbarSpacer />
                        <Button
                            text="Assign Employee"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press="onAssignEmployee"
                            visible="{= ${path: 'STATUS', targetType: 'any'} !== 'ON_HOLD' }"
                        />
                    </Toolbar>
                </headerToolbar>
               
                <Table
                    id="allocationTable"
                    width="auto"
                    growing="true"
                    growingThreshold="5"
                    growingScrollToLoad="true"
                    noDataText="No allocations yet"
                    items="{allocations}"
                >
                    <columns>
                        <Column
                            width="20%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Employee" />
                        </Column>
                        <Column
                            width="15%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Project Role" />
                        </Column>
                        <Column
                            width="20%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Allocation" />
                        </Column>
                        <Column
                            width="15%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Start Date" />
                        </Column>
                        <Column
                            width="15%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="End Date" />
                        </Column>
                        <Column
                            width="15%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Actions" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier
                                    class="sapMTableContentMargin"
                                    title="{employee/NAME}"
                                    text="{employee/EMP_ID}"
                                />
                                <Text
                                    text="{PROJECT_ROLE}"
                                    class="sapMTableContentMargin"
                                />
                                <ProgressIndicator
                                    percentValue="{ALLOCATION_PERCENTAGE}"
                                    displayValue="{ALLOCATION_PERCENTAGE}%"
                                    class="sapMTableContentMargin"
                                />
                                <Text
                                    text="{
                                        path:'START_DATE',
                                        type:'sap.ui.model.odata.type.Date'
                                    }"
                                    class="sapMTableContentMargin"
                                />
                                <Text
                                    text="{
                                        path:'END_DATE',
                                        type:'sap.ui.model.odata.type.Date'
                                    }"
                                    class="sapMTableContentMargin"
                                />
                                <HBox
                                    justifyContent="Start"
                                    class="sapMTableContentMargin"
                                >
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="Edit Allocation"
                                        press="onEditAllocation"
                                    />
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Remove Allocation"
                                        press="onDeleteAllocation"
                                    />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
            <!-- Allocation History -->
            <Panel
                expandable="true"
                expanded="true"
                class="sapUiMarginTopBottom"
            >
                <headerToolbar>
                    <Toolbar>
                        <Title text="Allocations History" />
                    </Toolbar>
                </headerToolbar>

             <Table
    id="allocationHistoryTable"
    items="{allocationHistory>/history}"
    width="auto"
    growing="true"
    growingThreshold="20"
    growingScrollToLoad="true"
    mode="None"
>
                    <columns>
                        <Column
                            width="10%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="History ID" />
                        </Column>
                        <Column
                            width="20%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Employee" />
                        </Column>
                        <Column
                            width="15%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Project ID" />
                        </Column>
                        <Column
                            width="12%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Allocation %" />
                        </Column>
                        <Column
                            width="15%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Project Role" />
                        </Column>
                        <Column
                            width="14%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="Start Date" />
                        </Column>
                        <Column
                            width="14%"
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            popinDisplay="Inline"
                            hAlign="Left"
                            vAlign="Top"
                        >
                            <Text text="End Date" />
                        </Column>
                    </columns>

                    <items>        <ColumnListItem>
            <cells>
                <Text
                    text="{allocationHistory>ALLOC_HISTORY_ID}"
                    class="sapMTableContentMargin"
                />
                <ObjectIdentifier
                    class="sapMTableContentMargin"
                    title="{allocationHistory>EMPLOYEE_NAME}"
                    text="{allocationHistory>EMP_ID}"
                />
                <Text
                    text="{allocationHistory>PROJECT_ID}"
                    class="sapMTableContentMargin"
                />
                <ObjectNumber
                    number="{allocationHistory>ALLOCATION_PERCENTAGE}"
                    unit="%"
                    class="sapMTableContentMargin"
                />
                <Text
                    text="{allocationHistory>PROJECT_ROLE}"
                    class="sapMTableContentMargin"
                />
                <Text
    text="{path: 'allocationHistory>START_DATE', formatter: '._formatDisplayDate'}"
    class="sapMTableContentMargin"
/>
<Text
    text="{path: 'allocationHistory>END_DATE', formatter: '._formatDisplayDate'}"
    class="sapMTableContentMargin"
/>
            </cells>
        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
    </Page>
</mvc:View>