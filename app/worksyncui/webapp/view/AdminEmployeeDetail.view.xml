<mvc:View
    controllerName="com.amista.worksyncui.controller.AdminEmployeeDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
>
    <Page
        title="Employee Details"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiContentPadding">

        <headerContent>
            <Button
                text="Edit Employee"
                icon="sap-icon://edit"
                type="Emphasized"
                press="onEditEmployee"
                visible="{= ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED' &amp;&amp; ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'}"

            />
        </headerContent>

        <content>

            <!-- Employee Header: stays visible above the tabs, unchanged bindings -->
            <ObjectHeader
                title="{NAME}"
                number="{EMP_ID}"
                intro="{designation/NAME}"
                responsive="true"
                icon="sap-icon://person-placeholder"
                class="sapUiTinyMarginBottom"
            >
                <statuses>
                    <ObjectStatus
                        text="{STATUS}"
                        state="{= ${STATUS} === 'ACTIVE' ? 'Success' :
                     ${STATUS} === 'ON_LEAVE' ? 'Warning' :
                     ${STATUS} === 'BENCH' ? 'Information' : 'Error'}"
                    />
                </statuses>

                <attributes>
                    <ObjectAttribute
                        title="Email"
                        text="{EMAIL}"
                    />

                    <ObjectAttribute
                        title="Phone"
                        text="{PHONE_NUMBER}"
                    />

                    <ObjectAttribute
                        title="Experience"
                        text="{EXPERIENCE} Years"
                    />
                </attributes>
            </ObjectHeader>

            <!-- Three clean sections instead of three stacked panels -->
            <IconTabBar id="employeeDetailTabBar" expandable="false" class="sapUiResponsiveContentPadding">
                <items>

                    <!-- OVERVIEW -->
                    <IconTabFilter key="overview" icon="sap-icon://detail-view" text="Overview">
                        <content>
                            <f:SimpleForm
                                editable="false"
                                layout="ResponsiveGridLayout"
                            >
                                <Label text="Employee ID" />
                                <Text text="{EMP_ID}" />

                                <Label text="Name" />
                                <Text text="{NAME}" />

                                <Label text="Email" />
                                <Text text="{EMAIL}" />

                                <Label text="Gender" />
                                <Text text="{GENDER}" />

                                <Label text="Phone" />
                                <Text text="{PHONE_NUMBER}" />

                                <Label text="Date of Birth" />
                                <Text text="{DATE_OF_BIRTH}" />

                                <Label text="Joining Date" />
                                <Text text="{JOINING_DATE}" />

                                <Label text="Designation" />
                                <Text text="{designation/NAME}" />

                                <Label text="Experience" />
                                <Text text="{EXPERIENCE} Years" />

                                <Label text="Status" />
                                <ObjectStatus
                                    text="{STATUS}"
                                    state="Success"
                                />
                            </f:SimpleForm>
                        </content>
                    </IconTabFilter>

                    <!-- SKILLS -->
                    <IconTabFilter key="skills" icon="sap-icon://competitor" text="Skills">
                        <content>
                            <Toolbar>
                                <Title text="Employee Skills" level="H3" />
                                <ToolbarSpacer />
                                <Button
                                    text="Add Skill"
                                    icon="sap-icon://add"
                                    type="Emphasized"
                                    press=".onAddEmployeeSkill"
                                    visible="{= ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED' &amp;&amp; ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'}"

                                />
                            </Toolbar>

                            <Table
                                growing="true"
                                growingThreshold="5"
                                items="{skills}"
                            >
                                <columns>
                                    <Column width="40%">
                                        <Text text="Skill" />
                                    </Column>
                                    <Column width="30%">
                                        <Text text="Proficiency" />
                                    </Column>
                                    <Column width="15%" hAlign="Center"
                                            visible="{= ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED' &amp;&amp; ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'}">
                                        <Text text="Edit" />
                                    </Column>
                                    <Column width="15%" hAlign="Center"
                                            visible="{= ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED' &amp;&amp; ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'}">
                                        <Text text="Delete" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{skill/SKILL_NAME}" />
                                            <Text text="{PROFICIENCY_LEVEL}" />
                                            <Button
                                                icon="sap-icon://edit"
                                                type="Transparent"
                                                tooltip="Edit Skill"
                                                press=".onEditEmployeeSkill"/>
                                            <Button
                                                icon="sap-icon://delete"
                                                type="Transparent"
                                                tooltip="Delete Skill"
                                                press=".onDeleteEmployeeSkill"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </IconTabFilter>

                    <!-- PROJECT ALLOCATIONS -->
                    <IconTabFilter key="allocations" icon="sap-icon://project-definition-triangle" text="Allocations">
                        <content>
                            <Title text="Project Allocations" level="H3" class="sapUiTinyMarginBottom" />

                            <Table
                                id="tblAllocations"
                                width="100%"
                                growing="true"
                                growingThreshold="5"
                                items="{allocations}"
                            >
                                <columns>
                                    <Column >
                                        <Text text="Project ID" />
                                    </Column>

                                    <Column>
                                        <Text text="Project Name" />
                                    </Column>

                                    <Column>
                                        <Text text="Project Role" />
                                    </Column>

                                    <Column>
                                        <Text text="Allocation" />
                                    </Column>

                                    <Column>
                                        <Text text="Start Date" />
                                    </Column>

                                    <Column >
                                        <Text text="End Date" />
                                    </Column>

                                    <!-- <Column width="10rem">
                                        <Text text="Status" />
                                    </Column> -->
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{project/PROJECT_ID}" />

                                            <Text text="{project/PROJECT_NAME}" />

                                            <Text text="{PROJECT_ROLE}" />

                                            <ProgressIndicator
                                                percentValue="{ALLOCATION_PERCENTAGE}"
                                                displayValue="{ALLOCATION_PERCENTAGE}%"
                                            />
                                            <Text text="{START_DATE}" />
                                            <Text text="{END_DATE}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </IconTabFilter>

                </items>
            </IconTabBar>

        </content>
    </Page>
</mvc:View>