<mvc:View
    controllerName="com.amista.worksyncui.controller.AdminEmployeeDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
>
    <Page
        title="Employee Details"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsiveContentPadding"
    >

        <headerContent>

            <Button
                text="Edit Employee"
                icon="sap-icon://edit"
                type="Emphasized"
                press="onEditEmployee"
                visible="{=
                    ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED'
                    &amp;&amp;
                    ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'
                }"
            />

        </headerContent>

        <content>
            <!-- EMPLOYEE PROFILE HEADER                           -->
<Panel
    id="employeeInformationPanel"
    headerText="Employee Information"
    class="sapUiSmallMarginBottom"
>
    <content>

        <HBox
            alignItems="Start"
            fitContainer="true"
            wrap="Wrap"
            class="sapUiMediumMargin"
        >

            <!-- Profile Photo -->
   <VBox
   class = "sapUiMediumMarginBottom sapUiMediumMarginEnd">
    <Image
        id="employeeProfileImage"
        src="{path: 'ID', formatter: '.formatProfilePhoto'}"
        width="120px"
        height="140px"
        densityAware="false"
        decorative="false"
        alt="{NAME}"
        visible="true"
        error=".onProfileImageError"
    />
    </VBox>

            <!-- Employee Details -->
            <VBox
                fitContainer="true"
                class="sapUiMediumMarginBottom"
            >

                <HBox
                    fitContainer="true"
                    wrap="Wrap"
                >

                    <!-- Employee ID -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Employee ID" />

                        <Text
                            text="{EMP_ID}"
                        />
                    </VBox>


                    <!-- Name -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Name" />

                        <Text
                            text="{NAME}"
                        />
                    </VBox>


                    <!-- Email -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Email" />

                        <Text
                            text="{EMAIL}"
                        />
                    </VBox>


                    <!-- Gender -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Gender" />

                        <Text
                            text="{GENDER}"
                        />
                    </VBox>


                    <!-- Phone Number -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Phone Number" />

                        <Text
                            text="{PHONE_NUMBER}"
                        />
                    </VBox>


                    <!-- Date of Birth -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Date of Birth" />

                        <Text
                            text="{DATE_OF_BIRTH}"
                        />
                    </VBox>


                    <!-- Joining Date -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Joining Date" />

                        <Text
                            text="{JOINING_DATE}"
                        />
                    </VBox>


                    <!-- Experience -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Experience" />

                        <Text
                            text="{EXPERIENCE}"
                        />
                    </VBox>


                    <!-- Designation -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Designation" />

                        <Text
                            text="{designation/NAME}"
                        />
                    </VBox>


                    <!-- Status -->
                    <VBox
                        width="50%"
                        class="sapUiSmallMarginBottom"
                    >
                        <Label text="Status" />

                        <ObjectStatus
                            text="{STATUS}"
                            state="{=
                                ${STATUS} === 'ACTIVE'
                                    ? 'Success'
                                    :
                                ${STATUS} === 'ON_LEAVE'
                                    ? 'Warning'
                                    :
                                ${STATUS} === 'BENCH'
                                    ? 'Information'
                                    :
                                'Error'
                            }"
                        />
                    </VBox>

                </HBox>

            </VBox>

        </HBox>

    </content>
</Panel>

            <!-- ================================================= -->
            <!-- EMPLOYEE DETAILS TABS                            -->
            <!-- ================================================= -->

            <VBox
    id="employeeDetailsSections"
    class="sapUiResponsiveContentPadding"
>

    <SegmentedButton
        id="employeeDetailSegmentedButton"
        selectedKey="skills"
        selectionChange=".onEmployeeSectionChange"
        width="100%"
    >
        <items>

            <SegmentedButtonItem
                key="skills"
                text="Skills"
                icon="sap-icon://competitor"
            />

            <SegmentedButtonItem
                key="allocations"
                text="Allocations"
                icon="sap-icon://project-definition-triangle"
            />

        </items>
    </SegmentedButton>


    <!-- Skills -->

    <VBox
        id="skillsSection"
        visible="true"
        class="sapUiMediumMarginTop"
    >

        <Toolbar>

            <Title
                text="Employee Skills"
                level="H3"
            />

            <ToolbarSpacer />

            <Button
                text="Add Skill"
                icon="sap-icon://add"
                type="Emphasized"
                press=".onAddEmployeeSkill"
                visible="{=
                    ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED'
                    &amp;&amp;
                    ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'
                }"
            />

        </Toolbar>

        <Table
            growing="true"
            growingThreshold="5"
            items="{skills}"
            noDataText="No skills available"
        >

            <columns>

                <Column width="40%">
                    <Text text="Skill" />
                </Column>

                <Column width="30%">
                    <Text text="Proficiency" />
                </Column>

                <Column
                    width="15%"
                    hAlign="Center"
                    visible="{=
                        ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED'
                        &amp;&amp;
                        ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'
                    }"
                >
                    <Text text="Edit" />
                </Column>

                <Column
                    width="15%"
                    hAlign="Center"
                    visible="{=
                        ${path: 'STATUS', targetType: 'any'} !== 'TERMINATED'
                        &amp;&amp;
                        ${path: 'STATUS', targetType: 'any'} !== 'RESIGNED'
                    }"
                >
                    <Text text="Delete" />
                </Column>

            </columns>

            <items>

                <ColumnListItem>

                    <cells>

                        <Text
                            text="{skill/SKILL_NAME}"
                        />

                        <ObjectStatus
                            text="{PROFICIENCY_LEVEL}"
                            state="{=
                                ${PROFICIENCY_LEVEL} === 'EXPERT'
                                    ? 'Success'
                                    :
                                ${PROFICIENCY_LEVEL} === 'ADVANCED'
                                    ? 'Information'
                                    :
                                ${PROFICIENCY_LEVEL} === 'INTERMEDIATE'
                                    ? 'Warning'
                                    :
                                'None'
                            }"
                        />

                        <Button
                            icon="sap-icon://edit"
                            type="Transparent"
                            tooltip="Edit Skill"
                            press=".onEditEmployeeSkill"
                        />

                        <Button
                            icon="sap-icon://delete"
                            type="Transparent"
                            tooltip="Delete Skill"
                            press=".onDeleteEmployeeSkill"
                        />

                    </cells>

                </ColumnListItem>

            </items>

        </Table>

    </VBox>


    <!-- Allocations -->

    <VBox
        id="allocationsSection"
        visible="false"
        class="sapUiMediumMarginTop"
    >

        <Toolbar>

            <Title
                text="Project Allocations"
                level="H3"
            />

            <ToolbarSpacer />

        </Toolbar>

        <Table
            id="tblAllocations"
            width="100%"
            growing="true"
            growingThreshold="5"
            items="{allocations}"
            noDataText="No project allocations available"
        >

            <columns>

                <Column>
                    <Text text="Project ID" />
                </Column>

                <Column>
                    <Text text="Project Name" />
                </Column>

                <Column>
                    <Text text="Project Role" />
                </Column>

                <Column>
                    <Text text="Allocation" />
                </Column>

                <Column>
                    <Text text="Start Date" />
                </Column>

                <Column>
                    <Text text="End Date" />
                </Column>

            </columns>

            <items>

                <ColumnListItem>

                    <cells>

                        <Text
                            text="{project/PROJECT_ID}"
                        />

                        <Text
                            text="{project/PROJECT_NAME}"
                        />

                        <Text
                            text="{PROJECT_ROLE}"
                        />

                        <ProgressIndicator
                            percentValue="{ALLOCATION_PERCENTAGE}"
                            displayValue="{ALLOCATION_PERCENTAGE}%"
                            state="{=
                                ${ALLOCATION_PERCENTAGE} >= 100
                                    ? 'Error'
                                    :
                                ${ALLOCATION_PERCENTAGE} >= 80
                                    ? 'Warning'
                                    :
                                'Success'
                            }"
                            width="100%"
                        />

                        <Text
                            text="{START_DATE}"
                        />

                        <Text
                            text="{END_DATE}"
                        />

                    </cells>

                </ColumnListItem>

            </items>

        </Table>

    </VBox>

</VBox>

        </content>

    </Page>

</mvc:View>