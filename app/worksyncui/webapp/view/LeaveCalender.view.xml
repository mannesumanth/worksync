<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="com.amista.worksyncui.controller.LeaveCalender"
>
    <Page
        id="leavePage"
        title="Leave Calendar"
    >

        <content>

            <VBox class="sapUiMediumMargin">
                <!-- STATUS FILTERS                             -->

                <IconTabHeader
                    id="leaveStatusTabs"
                    selectedKey="PENDING"
                    select=".onStatusTabSelect"
                    class="sapUiSmallMarginBottom"
                >
                    <items>

                        <IconTabFilter
                            key="PENDING"
                            text="Pending"
                            icon="sap-icon://pending"
                        />

                        <IconTabFilter
                            key="WITHDRAW_REQUEST"
                            text="Withdrawal Requests"
                            icon="sap-icon://undo"
                        />

                        <IconTabFilter
                            key="APPROVED"
                            text="Approved"
                            icon="sap-icon://accept"
                        />

                        <IconTabFilter
                            key="REJECTED"
                            text="Rejected"
                            icon="sap-icon://decline"
                        />

                    </items>

                </IconTabHeader>


                <!-- ========================================== -->
                <!-- LEAVE TABLE                                -->
                <!-- ========================================== -->

                <Table
                    id="leaveTable"
                    inset="false"
                    sticky="ColumnHeaders"
                    growing="true"
                    growingThreshold="20"
                    growingScrollToLoad="true"
                    noDataText="No leave requests available"
                    items="{
                        path: '/LEAVE_CALENDAR',
                        parameters: {
                            $expand: 'employee',
                            $orderby: 'createdAt desc'
                        }
                    }"
                >

                    <headerToolbar>

                        <OverflowToolbar>

                            <Title
                                text="Leave Requests"
                                level="H3"
                            />

                            <ToolbarSpacer />

                            <SearchField
                                id="leaveSearch"
                                width="18rem"
                                placeholder="Search Employee or Leave ID"
                                liveChange=".onSearch"
                                search=".onSearch"
                            />

                        </OverflowToolbar>

                    </headerToolbar>


                    <!-- ====================================== -->
                    <!-- COLUMNS                                -->
                    <!-- ====================================== -->

                    <columns>

                        <Column>
                            <Text text="Leave ID" />
                        </Column>

                        <Column>
                            <Text text="Employee" />
                        </Column>

                        <Column>
                            <Text text="Leave Type" />
                        </Column>

                        <Column>
                            <Text text="From" />
                        </Column>

                        <Column>
                            <Text text="To" />
                        </Column>

                        <Column>
                            <Text text="Status" />
                        </Column>

                        <Column>
                            <Text text="Update Status" />
                        </Column>

                    </columns>


                    <!-- ====================================== -->
                    <!-- ROWS                                   -->
                    <!-- ====================================== -->

                    <items>

                        <ColumnListItem>

                            <cells>

                                <Text
                                    text="{LEAVE_ID}"
                                />

                                <Text
                                    text="{employee/NAME}"
                                />

                                <Text
                                    text="{LEAVE_TYPE}"
                                />

                                <Text
                                    text="{LEAVE_FROM}"
                                    textAlign="Center"
                                />

                                <Text
                                    text="{LEAVE_TO}"
                                    textAlign="Center"
                                />

                                <ObjectStatus
                                    text="{STATUS}"
                                    state="{=
                                        ${STATUS} === 'APPROVED'
                                            ? 'Success'
                                            :
                                        ${STATUS} === 'REJECTED'
                                            ? 'Error'
                                            :
                                        ${STATUS} === 'PENDING'
                                            ? 'Warning'
                                            :
                                        ${STATUS} === 'WITHDRAW_REQUEST'
                                            ? 'Information'
                                            :
                                        'None'
                                    }"
                                />

                                <!-- Approve / Reject -->
                                <HBox
                                    justifyContent="Center"
                                    renderType="Bare"
                                    visible="{=${STATUS} === 'PENDING'}"
                                >

                                    <Button
                                        text="Approve"
                                        type="Accept"
                                        icon="sap-icon://accept"
                                        press=".onApproveLeave"
                                    />

                                    <Button
                                        text="Reject"
                                        type="Reject"
                                        icon="sap-icon://decline"
                                        class="sapUiTinyMarginBegin"
                                        press=".onRejectLeave"
                                    />

                                </HBox>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>
</mvc:View>