<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="com.amista.worksyncui.controller.LeaveCalender"
>
    <Page
        id="leavePage"
        title="Leave Calendar"
    >

        <content>

            <VBox class="sapUiMediumMargin">

                <!-- Row 1: Title + Search -->
                <Toolbar id="titleBar">
                    <Title text="Leave Requests" level="H3" />
                    <ToolbarSpacer />
                    <SearchField
                        id="leaveSearch"
                        width="256px"
                        placeholder="Search Employee or Leave ID"
                        liveChange=".onSearch"
                        search=".onSearch"
                    />
                </Toolbar>

                <!-- Row 2: Status Filter -->
                <OverflowToolbar
                    id="filterBar"
                    class="sapUiTinyMarginTop"
                >
                    <SegmentedButton
                        id="leaveStatusFilter"
                        selectedKey="ALL"
                        selectionChange=".onFilterChange"
                    >
                        <items>
                            <SegmentedButtonItem key="ALL" text="All" />
                            <SegmentedButtonItem key="PENDING" text="Pending" />
                            <SegmentedButtonItem key="WITHDRAW_REQUEST" text="Withdrawal Requests" />
                            <SegmentedButtonItem key="WITHDRAWN" text="Withdrawn" />
                            <SegmentedButtonItem key="CANCELLED" text="Cancelled" />
                            <SegmentedButtonItem key="APPROVED" text="Approved" />
                            <SegmentedButtonItem key="REJECTED" text="Rejected" />
                            
                        </items>
                    </SegmentedButton>
                </OverflowToolbar>

                <!-- Row 3: Actions Bar -->
                <Toolbar
                    id="actionsBar"
                    design="Info"
                    class="sapUiTinyMarginTop sapUiTinyMarginBottom"
                >
                    <Text text="{ui>/selectedCount} selected" />
                    <ToolbarSpacer />
                    <Button
                        text="Approve Selected"
                        type="Accept"
                        icon="sap-icon://accept"
                        enabled="{ui>/bulkActionsEnabled}"
                        press=".onBulkApprove"
                    />
                    <Button
                        text="Reject Selected"
                        type="Reject"
                        icon="sap-icon://decline"
                        enabled="{ui>/bulkActionsEnabled}"
                        press=".onBulkReject"
                    />
                </Toolbar>

                <!-- Table -->
                <Table
                    id="leaveTable"
                    inset="false"
                    sticky="ColumnHeaders"
                    growing="true"
                    growingThreshold="20"
                    growingScrollToLoad="true"
                    noDataText="No leave requests available"
                    mode="{ui>/selectionMode}"
                    selectionChange=".onSelectionChange"
                    items="{
                        path: '/LEAVE_CALENDAR',
                        parameters: {
                            $expand: 'employee',
                            $orderby: 'createdAt desc'
                        }
                    }"
                >

                    <columns>

                        <Column>
                            <Text text="Leave ID" />
                        </Column>

                        <Column>
                            <Text text="Employee" />
                        </Column>

                        <Column>
                            <Text text="Leave Type" />
                        </Column>

                        <Column>
                            <Text text="From" />
                        </Column>

                        <Column>
                            <Text text="To" />
                        </Column>

                        <Column hAlign="Center">
                            <Text text="Days" />
                        </Column>

                        <Column>
                            <Text text="Reason" />
                        </Column>

                        <Column width="11rem">
                            <Text text="Status" />
                        </Column>

                    </columns>


                    <items>

                        <ColumnListItem>

                            <cells>

                                <Text text="{LEAVE_ID}" />

                                <Text text="{employee/NAME}" />

                                <Text text="{LEAVE_TYPE}" />

                                <Text text="{LEAVE_FROM}" textAlign="Center" />

                                <Text text="{LEAVE_TO}" textAlign="Center" />

                                <ObjectNumber
                                    number="{
                                        parts: [{path: 'LEAVE_FROM'}, {path: 'LEAVE_TO'}],
                                        formatter: '._calculateDays'
                                    }"
                                    textAlign="Center"
                                />

                                <Text
                                    text="{REASON}"
                                    maxLines="2"
                                    class="sapMTableContentMargin"
                                />

                                <ObjectStatus
                                    text="{STATUS}"
                                    state="{=
                                        ${STATUS} === 'APPROVED'
                                            ? 'Success'
                                            :
                                        ${STATUS} === 'REJECTED'
                                            ? 'Error'
                                            :
                                        ${STATUS} === 'PENDING'
                                            ? 'Warning'
                                            :
                                        ${STATUS} === 'WITHDRAW_REQUEST'
                                            ? 'Information'
                                            :
                                        'None'
                                    }"
                                    icon="{=
                                        ${STATUS} === 'WITHDRAWN'
                                            ? 'sap-icon://undo'
                                            :
                                        ${STATUS} === 'CANCELLED'
                                            ? 'sap-icon://cancel'
                                            :
                                        ''
                                    }"
                                />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>
</mvc:View>