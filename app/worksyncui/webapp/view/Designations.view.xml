<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    controllerName="com.amista.worksyncui.controller.Designations"
    displayBlock="true">

    <Page id="designationsPage" title="Designations">
        <headerContent>
            <Button 
                text="Add Designation" 
                icon="sap-icon://add" 
                type="Emphasized"
                press=".onOpenDesignationDialog" />
        </headerContent>
        <content>
            <VBox class="sapUiMediumMargin">
                <Table 
                    id="designationsTable" 
                    inset="false" 
                    sticky="ColumnHeaders" 
                    noDataText="No designations available"  
                    items="{ 
                        path: '/DESIGNATIONS',
                        sorter: {
                            path: 'DESIGNATION_ID'
                        }
                    }">
                    <columns>
                        <Column >
                            <Text text="Designation ID" />
                        </Column>
                        <Column >
                            <Text text="Designation Name" />
                        </Column>
                        <Column >
                            <Text text="Edit" />
                        </Column>
                        <Column >
                            <Text text="Delete" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{DESIGNATION_ID}" />
                                <Text text="{NAME}" />
                                <Button 
                                    icon="sap-icon://edit" 
                                    type="Transparent" 
                                    tooltip="Edit Designation" 
                                    press=".onEditDesignation"/>
                                <Button 
                                    icon="sap-icon://delete" 
                                    type="Transparent" 
                                    tooltip="Delete Designation" 
                                    press=".onDeleteDesignation" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>