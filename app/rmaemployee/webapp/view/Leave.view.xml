<mvc:View
    controllerName="com.amista.rmaemployee.controller.Leave"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
>
    <Page
        id="leavePage"
        title="Leave"
        class="sapUiResponsiveContentPadding"
    >
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- Leave Balance -->
                <Panel
                    id="leaveBalancePanel"
                    headerText="Leave Balance"
                    class="sapUiMediumMarginBottom"
                >
                    <content>
                        <HBox
                            wrap="Wrap"
                            justifyContent="SpaceBetween"
                            class="sapUiMediumMargin"
                        >

                            <!-- Casual -->
                            <VBox
                                class="sapUiSmallMargin"
                            >
                                <Label text="Casual Leave" />

                                <ObjectNumber
                                    number="{leaveBalance>/0/CASUAL_AVAILABLE}"
                                    unit="Days"
                                />

                                <Text
                                    text="Used: {leaveBalance>/0/CASUAL_USED} days"
                                />
                            </VBox>


                            <!-- Sick -->
                            <VBox
                                class="sapUiSmallMargin"
                            >
                                <Label text="Sick Leave" />

                                <ObjectNumber
                                    number="{leaveBalance>/0/SICK_AVAILABLE}"
                                    unit="Days"
                                />

                                <Text
                                    text="Used: {leaveBalance>/0/SICK_USED} days"
                                />
                            </VBox>


                            <!-- Earned -->
                            <VBox
                                class="sapUiSmallMargin"
                            >
                                <Label text="Earned Leave" />

                                <ObjectNumber
                                    number="{leaveBalance>/0/EARNED_AVAILABLE}"
                                    unit="Days"
                                />

                                <Text
                                    text="Used: {leaveBalance>/0/EARNED_USED} days"
                                />
                            </VBox>


                            <!-- Loss of Pay -->
                            <VBox
                                class="sapUiSmallMargin"
                            >
                                <Label text="Loss of Pay" />

                                <ObjectNumber
                                    number="{leaveBalance>/0/UNPAID_USED}"
                                    unit="Days"
                                />

                                <Text text="Used" />
                            </VBox>

                        </HBox>

                    </content>
                </Panel>


                <!-- Apply Leave -->
                <Panel
                    id="applyLeavePanel"
                    headerText="Apply Leave"
                    class="sapUiMediumMarginBottom"
                >
                    <content>

                        <VBox class="sapUiMediumMargin">

                            <Label text="Leave Type" />

                            <Select
                                id="leaveTypeSelect"
                                selectedKey=""
                                width="100%"
                            >
                                <items>

                                    <core:Item
                                        key="CASUAL"
                                        text="Casual Leave"
                                    />

                                    <core:Item
                                        key="SICK"
                                        text="Sick Leave"
                                    />

                                    <core:Item
                                        key="EARNED"
                                        text="Earned Leave"
                                    />

                                    <core:Item
                                        key="MATERNITY"
                                        text="Maternity Leave"
                                    />

                                    <core:Item
                                        key="PATERNITY"
                                        text="Paternity Leave"
                                    />

                                    <core:Item
                                        key="UNPAID"
                                        text="Loss of Pay"
                                    />

                                </items>
                            </Select>


                            <Label
                                text="Leave From"
                                class="sapUiSmallMarginTop"
                            />

                            <DatePicker
                                id="leaveFromDate"
                                width="100%"
                                change=".onLeaveDateChange"
                            />


                            <Label
                                text="Leave To"
                                class="sapUiSmallMarginTop"
                            />

                            <DatePicker
                                id="leaveToDate"
                                width="100%"
                                change=".onLeaveDateChange"
                            />


                            <Label
                                text="Number of Days"
                                class="sapUiSmallMarginTop"
                            />

                            <Input
                                id="leaveDays"
                                editable="false"
                                width="100%"
                            />


                            <Label
                                text="Reason"
                                class="sapUiSmallMarginTop"
                            />

                            <TextArea
                                id="leaveReason"
                                rows="4"
                                width="100%"
                                placeholder="Enter reason for leave"
                            />


                            <Button
                                id="applyLeaveButton"
                                text="Apply Leave"
                                type="Emphasized"
                                icon="sap-icon://accept"
                                press=".onApplyLeave"
                                class="sapUiSmallMarginTop"
                            />

                        </VBox>

                    </content>
                </Panel>


                <!-- Leave Calendar -->
                <Panel
                    id="leaveCalendarPanel"
                    headerText="Leave Calendar"
                    class="sapUiMediumMarginBottom"
                >
                    <content>

                        <VBox class="sapUiMediumMargin">

                            <unified:Calendar
                                id="leaveCalendar"
                                months="2"
                                width="100%"
                            />

                        </VBox>

                    </content>
                </Panel>


                <!-- Leave History -->
                <Panel
    id="leaveHistoryPanel"
    headerText="Leave History"
>
    <content>

        <!-- Leave Status Filter -->
<SegmentedButton
    id="leaveStatusFilter"
    selectedKey="ALL"
    selectionChange=".onLeaveStatusFilter"
    width="100%"
>
    <items>

        <SegmentedButtonItem
            key="ALL"
            text="All"
        />

        <SegmentedButtonItem
            key="PENDING"
            text="Pending"
        />

        <SegmentedButtonItem
            key="APPROVED"
            text="Approved"
        />

        <SegmentedButtonItem
            key="REJECTED"
            text="Rejected"
        />

        <SegmentedButtonItem
            key="CANCELLED"
            text="Cancelled"
        />

        <SegmentedButtonItem
            key="WITHDRAW_REQUEST"
            text="Withdrawal Request"
        />

    </items>
</SegmentedButton>

        <!-- Leave History Table -->

        <Table
            id="leaveHistoryTable"
            items="{leaves>/}"
            growing="true"
            growingScrollToLoad="true"
            noDataText="No leave history available"
        >

            <columns>
                <Column>
                    <Text text="Leave ID" />
                </Column>


                <Column>
                    <Text text="Leave Type" />
                </Column>

                <Column>
                    <Text text="From" />
                </Column>

                <Column>
                    <Text text="To" />
                </Column>

                <Column>
                    <Text text="Days" />
                </Column>

                <Column>
                    <Text text="Reason" />
                </Column>

                <Column>
                    <Text text="Status" />
                </Column>

                <Column
                id="leaveActionColumn">
                    <Text text="Action" />
                </Column>

            </columns>


            <items>

                <ColumnListItem>

                    <cells>
                        <Text
                            text="{leaves>LEAVE_ID}"
                        />

                        <Text
                            text="{leaves>LEAVE_TYPE}"
                        />

                        <Text
                            text="{leaves>LEAVE_FROM}"
                        />

                        <Text
                            text="{leaves>LEAVE_TO}"
                        />

                        <Text
                            text="{leaves>DAYS}"
                        />

                        <Text
                            text="{leaves>REASON}"
                        />

                        <ObjectStatus
                            text="{leaves>STATUS}"
                            state="{=
                                ${leaves>STATUS} === 'APPROVED'
                                    ? 'Success'
                                    :
                                ${leaves>STATUS} === 'PENDING'
                                    ? 'Warning'
                                    :
                                ${leaves>STATUS} === 'REJECTED'
                                    ? 'Error'
                                    :
                                ${leaves>STATUS} === 'WITHDRAW_REQUEST'
                                    ? 'Information'
                                    :
                                'None'
                            }"
                        />

                        <HBox>

                            <!-- Cancel Pending Leave -->

                            <Button
                                text="Cancel"
                                type="Reject"
                                visible="{=
                                    ${leaves>STATUS} === 'PENDING'
                                }"
                                press=".onCancelLeave"
                            />

                            <!-- Withdraw Approved Leave -->

                            <Button
                                text="Withdraw"
                                type="Reject"
                                visible="{=
                                    ${leaves>STATUS} === 'APPROVED'
                                }"
                                press=".onWithdrawLeave"
                                class="sapUiTinyMarginBegin"
                            />

                        </HBox>

                    </cells>

                </ColumnListItem>

            </items>

        </Table>

    </content>
</Panel>
            </VBox>

        </content>

    </Page>
</mvc:View>